PORT=3456
ADMIN_EMAIL=your-admin-email@example.com
SESSION_SECRET=generate-with-openssl-rand-base64-32
# Required for all application email sending; inject from 1Password, never commit a value.
SMTP2GO_API_KEY=
SMTP2GO_API_BASE_URL=https://api.smtp2go.com/v3
# Automatic retries apply only to explicit SMTP2GO 429 responses.
SMTP2GO_MAX_RETRIES=3
SMTP2GO_RETRY_DELAY_MS=1000
SMTP2GO_REQUEST_TIMEOUT_MS=15000
SMTP2GO_INVITE_SENDS_PER_SECOND=4
FROM_EMAIL=admin@dunedin-euchre.com
ROSTER_FROM_EMAIL=Do_Not_Reply@dunedin-euchre.com
EVENT_REMINDER_TIMEZONE=America/New_York
EVENT_RSVP_SUMMARY_EMAIL=your-mom-email@example.com
EVENT_RSVP_SUMMARY_TIMEZONE=America/New_York
EVENT_RSVP_SUMMARY_HOUR=16
BASE_URL=https://dunedin-euchre.com
NODE_ENV=production
