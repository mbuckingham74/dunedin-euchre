<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – <%= formatEventDate(event.event_date) %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2563eb">
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <span class="site-title">&#9830; Dunedin Euchre</span>
    <span class="header-sub">Monthly Tournament</span>
  </div>
</header>

<main style="max-width:680px;margin:0 auto;padding:1.5rem;">

  <section class="card event-card" style="margin-bottom:1.5rem;">
    <h2 class="event-date-heading"><%= formatEventDate(event.event_date) %></h2>
    <div class="event-meta">
      <div class="event-meta-row">
        <span class="meta-label">Location</span>
        <span class="meta-value"><%= event.location_name %></span>
      </div>
      <div class="event-meta-row">
        <span class="meta-label">Time</span>
        <span class="meta-value"><%= formatTime(event.start_time) %> – <%= formatTime(event.end_time) %></span>
      </div>
    </div>
    <% if (event.notes) { %>
      <div class="event-notes">
        <span class="notes-label">Note</span>
        <p class="notes-text"><%= event.notes %></p>
      </div>
    <% } %>
    <% if (event.location_image) { %>
      <div class="location-image-wrap">
        <p class="location-image-caption">Building entrance</p>
        <img src="/uploads/<%= event.location_image %>" alt="Entrance" class="location-image">
      </div>
    <% } %>
  </section>

  <section class="card roster-card">
    <h3 class="roster-heading">Attendance</h3>
    <div class="roster-counts">
      <span class="count-badge count-yes"><%= counts.yes %> Yes</span>
      <span class="count-badge count-maybe"><%= counts.maybe %> Maybe</span>
      <span class="count-badge count-no"><%= counts.no %> No</span>
      <span class="count-badge count-none"><%= counts.none %> Pending</span>
    </div>

    <ul class="roster-list">
      <% roster.forEach(function(p) { %>
        <li class="roster-item roster-<%= p.status || 'none' %>" data-pid="<%= p.id %>">
          <span class="roster-name"><%= p.name %></span>
          <span class="roster-status">
            <% if (p.status === 'yes') { %>
              <span class="status-pill pill-yes">✓ Yes</span>
            <% } else if (p.status === 'no') { %>
              <span class="status-pill pill-no">✕ No</span>
            <% } else if (p.status === 'maybe') { %>
              <span class="status-pill pill-maybe">? Maybe</span>
            <% } else { %>
              <span class="status-pill pill-none">—</span>
            <% } %>
          </span>
          <% if (p.comment) { %>
            <span class="roster-comment">"<%= p.comment %>"</span>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </section>

</main>
</body>
</html>
