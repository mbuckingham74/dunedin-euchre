<div class="form-group">
  <label class="form-label">Date</label>
  <input
    type="date"
    name="event_date"
    class="form-input"
    required
    value="<%= event ? event.event_date : '' %>"
  >
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Location name</label>
  <input
    type="text"
    name="location_name"
    class="form-input"
    required
    placeholder="e.g. Dunedin Community Center"
    value="<%= event ? event.location_name : '' %>"
  >
</div>

<div class="form-row" style="margin-top:0.75rem;">
  <div class="form-group">
    <label class="form-label">Start time</label>
    <input
      type="time"
      name="start_time"
      class="form-input"
      required
      value="<%= event ? event.start_time : '18:00' %>"
    >
  </div>
  <div class="form-group">
    <label class="form-label">End time</label>
    <input
      type="time"
      name="end_time"
      class="form-input"
      required
      value="<%= event ? event.end_time : '21:00' %>"
    >
  </div>
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Notes <span style="font-weight:400;color:#64748b;">(shown prominently on RSVP page)</span></label>
  <textarea
    name="notes"
    class="form-input"
    rows="3"
    placeholder="e.g. Bring a sweater, the AC runs cold. Parking in Lot B."
  ><%= event ? (event.notes || '') : '' %></textarea>
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Building entrance photo <span style="font-weight:400;color:#64748b;">(optional)</span></label>
  <% if (event && event.location_image) { %>
    <div style="margin-bottom:0.5rem;">
      <img src="/uploads/<%= event.location_image %>" alt="Current image" style="max-height:100px;border-radius:4px;">
      <span style="font-size:0.85rem;color:#64748b;display:block;margin-top:0.25rem;">Upload a new photo to replace this one.</span>
    </div>
  <% } %>
  <input type="file" name="location_image" class="form-input" accept="image/*">
</div>
