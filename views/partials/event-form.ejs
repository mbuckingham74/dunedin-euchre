<div class="form-group">
  <label class="form-label">Event title</label>
  <input
    type="text"
    name="title"
    class="form-input"
    required
    placeholder="e.g. April Euchre Night"
    value="<%= event ? event.title : 'Dunedin Euchre Night' %>"
  >
</div>

<div class="form-row" style="margin-top:0.75rem;">
  <div class="form-group">
    <label class="form-label">Date</label>
    <input
      type="date"
      name="event_date"
      class="form-input"
      required
      value="<%= event ? event.event_date : '' %>"
    >
  </div>
  <div class="form-group">
    <label class="form-label">Location name</label>
    <input
      type="text"
      name="location_name"
      class="form-input"
      required
      placeholder="e.g. Dunedin Community Center"
      value="<%= event ? event.location_name : '' %>"
    >
  </div>
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Location address <span style="font-weight:400;color:#64748b;">(optional)</span></label>
  <textarea
    name="location_address"
    class="form-input"
    rows="3"
    placeholder="e.g. 123 Main St&#10;Dunedin, FL 34698"
  ><%= event ? (event.location_address || '') : '' %></textarea>
</div>

<div class="form-row" style="margin-top:0.75rem;">
  <div class="form-group">
    <label class="form-label">Start time</label>
    <input
      type="time"
      name="start_time"
      class="form-input"
      required
      value="<%= event ? event.start_time : '18:00' %>"
    >
  </div>
  <div class="form-group">
    <label class="form-label">End time</label>
    <input
      type="time"
      name="end_time"
      class="form-input"
      required
      value="<%= event ? event.end_time : '21:00' %>"
    >
  </div>
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Arrival / parking notes <span style="font-weight:400;color:#64748b;">(optional)</span></label>
  <textarea
    name="arrival_notes"
    class="form-input"
    rows="3"
    placeholder="e.g. Park in Lot B and use the west entrance."
  ><%= event ? ((event.arrival_notes || event.notes) || '') : '' %></textarea>
</div>

<div class="form-row" style="margin-top:0.75rem;">
  <div class="form-group">
    <label class="form-label">Venue photo <span style="font-weight:400;color:#64748b;">(optional)</span></label>
    <% if (event && event.location_image) { %>
      <div class="event-upload-preview">
        <img src="/uploads/<%= event.location_image %>" alt="Current venue photo" class="event-upload-preview-image">
        <span class="event-upload-preview-text">Upload a new photo to replace this one.</span>
      </div>
    <% } %>
    <input type="file" name="location_image" class="form-input" accept="image/*">
  </div>

  <div class="form-group">
    <label class="form-label">Map image <span style="font-weight:400;color:#64748b;">(optional)</span></label>
    <% if (event && event.map_image) { %>
      <div class="event-upload-preview">
        <img src="/uploads/<%= event.map_image %>" alt="Current map image" class="event-upload-preview-image">
        <span class="event-upload-preview-text">Upload a new screenshot to replace this one.</span>
      </div>
    <% } %>
    <input type="file" name="map_image" class="form-input" accept="image/*">
  </div>
</div>

<label class="form-checkbox" style="margin-top:1rem;">
  <input type="checkbox" name="is_published" value="1" <%= event && Number(event.is_published) ? 'checked' : '' %>>
  <span>Publish public event page</span>
</label>
