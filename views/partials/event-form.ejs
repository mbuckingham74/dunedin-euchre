<% const selectedLocation = event && event.location_id
  ? locations.find(location => location.id === Number(event.location_id))
  : null; %>

<div class="form-group">
  <label class="form-label">Event title</label>
  <input
    type="text"
    name="title"
    class="form-input"
    required
    placeholder="e.g. April Euchre Night"
    value="<%= event ? event.title : 'Dunedin Euchre Night' %>"
  >
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Public URL slug <span style="font-weight:400;color:var(--gray-500);">(optional)</span></label>
  <input
    type="text"
    name="public_slug"
    class="form-input"
    placeholder="e.g. april-2026-euchre"
    value="<%= event ? (event.public_slug || '') : '' %>"
  >
  <p style="margin:0.45rem 0 0;font-size:0.9rem;color:var(--gray-500);">If set, the published event page uses <code>/e/your-slug</code>. We normalize this to lowercase letters, numbers, and hyphens, and older slug links keep redirecting if you change it later.</p>
</div>

<div class="form-row" style="margin-top:0.75rem;">
  <div class="form-group">
    <label class="form-label">Date</label>
    <input
      type="date"
      name="event_date"
      class="form-input"
      required
      value="<%= event ? event.event_date : '' %>"
    >
  </div>
  <div class="form-group">
    <label class="form-label">Saved location</label>
    <select
      name="location_id"
      class="form-input"
      data-location-select
      <%= locations.length === 0 ? 'disabled' : '' %>
    >
      <option value="">Select a saved location</option>
      <% locations.forEach(function(location) { %>
        <option
          value="<%= location.id %>"
          <%= selectedLocation && selectedLocation.id === location.id ? 'selected' : '' %>
          data-name="<%= location.name %>"
          data-address="<%= location.address %>"
          data-photo="<%= location.location_image ? '/uploads/' + location.location_image : '' %>"
          data-map-embed="<%= location.map_embed_url || '' %>"
          data-map-link="<%= location.map_link_url || '' %>"
        >
          <%= location.name %>
        </option>
      <% }); %>
    </select>
    <% if (locations.length === 0) { %>
      <p style="margin:0.45rem 0 0;font-size:0.9rem;color:var(--gray-500);">Add a saved location first on the <a href="/admin/locations">Locations page</a> before creating a new event.</p>
    <% } else { %>
      <p style="margin:0.45rem 0 0;font-size:0.9rem;color:var(--gray-500);">Manage venue addresses, photos, and map embeds on the <a href="/admin/locations">Locations page</a>.</p>
    <% } %>
  </div>
</div>

<% if (event && !event.location_id) { %>
  <input type="hidden" name="location_name" value="<%= event.location_name || '' %>">
  <input type="hidden" name="location_address" value="<%= event.location_address || '' %>">
  <div class="location-legacy-note" style="margin-top:0.75rem;">
    This event is still using its older one-off location details. You can keep them as-is, or choose a saved location above to standardize it.
  </div>
<% } %>

<div
  class="location-preview-card"
  data-location-preview
  <%= selectedLocation ? '' : 'hidden' %>
>
  <div class="location-preview-copy">
    <p class="location-preview-label">Saved location preview</p>
    <h4 class="location-preview-name" data-location-preview-name><%= selectedLocation ? selectedLocation.name : '' %></h4>
    <p class="location-preview-address" data-location-preview-address><%= selectedLocation ? selectedLocation.address : '' %></p>
    <a
      href="<%= selectedLocation && selectedLocation.map_link_url ? selectedLocation.map_link_url : '#' %>"
      target="_blank"
      rel="noreferrer"
      class="event-map-link"
      data-location-preview-link
      <%= selectedLocation && selectedLocation.map_link_url ? '' : 'hidden' %>
    >
      Open map
    </a>
  </div>

  <div class="location-preview-media">
    <div
      class="location-preview-photo-wrap"
      data-location-preview-photo-wrap
      <%= selectedLocation && selectedLocation.location_image ? '' : 'hidden' %>
    >
      <img
        src="<%= selectedLocation && selectedLocation.location_image ? '/uploads/' + selectedLocation.location_image : '' %>"
        alt="Selected venue"
        class="location-preview-photo"
        data-location-preview-photo
      >
    </div>
    <iframe
      src="<%= selectedLocation && selectedLocation.map_embed_url ? selectedLocation.map_embed_url : '' %>"
      title="Saved location map preview"
      class="event-map-embed location-preview-map"
      data-location-preview-map
      loading="lazy"
      referrerpolicy="no-referrer"
      <%= selectedLocation && selectedLocation.map_embed_url ? '' : 'hidden' %>
    ></iframe>
  </div>
</div>

<div class="form-row" style="margin-top:0.75rem;">
  <div class="form-group">
    <label class="form-label">Start time</label>
    <input
      type="time"
      name="start_time"
      class="form-input"
      required
      value="<%= event ? event.start_time : '18:00' %>"
    >
  </div>
  <div class="form-group">
    <label class="form-label">End time</label>
    <input
      type="time"
      name="end_time"
      class="form-input"
      required
      value="<%= event ? event.end_time : '21:00' %>"
    >
  </div>
</div>

<div class="form-group" style="margin-top:0.75rem;">
  <label class="form-label">Arrival / parking notes <span style="font-weight:400;color:var(--gray-500);">(optional)</span></label>
  <textarea
    name="arrival_notes"
    class="form-input"
    rows="3"
    placeholder="e.g. Park in Lot B and use the west entrance."
  ><%= event ? ((event.arrival_notes || event.notes) || '') : '' %></textarea>
</div>

<label class="form-checkbox" style="margin-top:1rem;">
  <input type="checkbox" name="show_public_roster" value="1" <%= event && Number(event.show_public_roster) ? 'checked' : '' %>>
  <span>Show attendee names on the published event page</span>
</label>
<p style="margin:0.45rem 0 0;font-size:0.9rem;color:var(--gray-500);">RSVP counts stay visible on the published event page. Names stay hidden unless you enable this.</p>

<label class="form-checkbox" style="margin-top:1rem;">
  <input type="checkbox" name="is_published" value="1" <%= event && Number(event.is_published) ? 'checked' : '' %>>
  <span>Publish event page</span>
</label>
