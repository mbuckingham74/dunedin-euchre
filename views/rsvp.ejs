<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – RSVP</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0077b6">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Dunedin Euchre">
  <meta name="referrer" content="no-referrer">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
</head>
<body class="rsvp-page">

<header class="site-header">
  <div class="header-inner">
    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="site-logo">
    <span class="site-title">Dunedin Euchre</span>
    <span class="header-sub">Monthly Tournament</span>
  </div>
</header>

<main class="rsvp-layout">

  <!-- LEFT COLUMN: event info + form -->
  <div class="rsvp-left">

    <%- include('./partials/event-overview', {
      event,
      formatEventDate,
      formatTime,
      eventTitle,
      arrivalNotes
    }) %>

    <!-- RSVP Form -->
    <section class="card rsvp-form-card" id="rsvp-form-section">
      <h3 class="form-heading">Your RSVP</h3>
      <p class="greeting">Hi, <strong><%= participant.name %></strong></p>

      <%
        const selectedAttendeeNames = myResponse ? myResponse.attendeeNames : [];
        const householdInvite = participantPartyMembers.length > 1;
        const pairInvite = participantPartyMembers.length === 2;
        const firstPairMember = pairInvite ? participantPartyMembers[0] : '';
        const secondPairMember = pairInvite ? participantPartyMembers[1] : '';
        const householdAllSelected = householdInvite &&
          selectedAttendeeNames.length === participantPartyMembers.length &&
          participantPartyMembers.length > 0;
        const householdPartialSelected = householdInvite &&
          selectedAttendeeNames.length > 0 &&
          selectedAttendeeNames.length < participantPartyMembers.length;
        const firstOnlySelected = pairInvite &&
          selectedAttendeeNames.length === 1 &&
          selectedAttendeeNames[0] === firstPairMember;
        const secondOnlySelected = pairInvite &&
          selectedAttendeeNames.length === 1 &&
          selectedAttendeeNames[0] === secondPairMember;
        const householdAllLabel = participantPartyMembers.length === 2
          ? "We'll both attend"
          : 'Everyone will attend';
        function joinNames(names) {
          if (!names || names.length === 0) return '';
          if (names.length === 1) return names[0];
          if (names.length === 2) return names[0] + ' and ' + names[1];
          return names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1];
        }

        let currentStatusText = 'No response yet';
        let currentStatusClass = 'status-none';
        let currentDetailText = 'You have not replied for this event yet.';

        if (myResponse && myResponse.status === 'yes') {
          currentStatusText = '✓ Yes';
          currentStatusClass = 'status-yes';
          currentDetailText = myResponse.declinedNames.length > 0
            ? 'Coming: ' + joinNames(myResponse.attendeeNames) + '. Not attending: ' + joinNames(myResponse.declinedNames) + '.'
            : 'Coming: ' + joinNames(myResponse.attendeeNames) + '.';
        } else if (myResponse && myResponse.status === 'maybe') {
          currentStatusText = '? Maybe';
          currentStatusClass = 'status-maybe';
          currentDetailText = 'Still deciding for ' + joinNames(myResponse.partyMembers) + '.';
        } else if (myResponse && myResponse.status === 'no') {
          currentStatusText = '✕ No';
          currentStatusClass = 'status-no';
          currentDetailText = 'Not attending: ' + joinNames(myResponse.partyMembers) + '.';
        }
      %>

      <div class="status-buttons" id="status-buttons">
        <% if (householdInvite) { %>
          <button
            type="button"
            class="btn-status btn-yes <%= householdAllSelected ? 'active' : '' %>"
            data-mode="yes-all"
            <%= !canEdit ? 'disabled' : '' %>
          >
            ✓ <%= householdAllLabel %>
          </button>
          <% if (pairInvite) { %>
            <button
              type="button"
              class="btn-status btn-some <%= firstOnlySelected ? 'active' : '' %>"
              data-mode="yes-first"
              <%= !canEdit ? 'disabled' : '' %>
            >
              ◐ <%= firstPairMember %> will attend
            </button>
            <button
              type="button"
              class="btn-status btn-some <%= secondOnlySelected ? 'active' : '' %>"
              data-mode="yes-second"
              <%= !canEdit ? 'disabled' : '' %>
            >
              ◐ <%= secondPairMember %> will attend
            </button>
          <% } else { %>
            <button
              type="button"
              class="btn-status btn-some <%= householdPartialSelected ? 'active' : '' %>"
              data-mode="yes-some"
              <%= !canEdit ? 'disabled' : '' %>
            >
              ◐ Choose who will attend
            </button>
          <% } %>
          <button
            type="button"
            class="btn-status btn-no <%= (myResponse && myResponse.status === 'no') ? 'active' : '' %>"
            data-mode="no"
            <%= !canEdit ? 'disabled' : '' %>
          >
            ✕ None of us can attend
          </button>
          <button
            type="button"
            class="btn-status btn-maybe <%= (myResponse && myResponse.status === 'maybe') ? 'active' : '' %>"
            data-mode="maybe"
            <%= !canEdit ? 'disabled' : '' %>
          >
            ? We're not sure yet
          </button>
        <% } else { %>
          <button
            type="button"
            class="btn-status btn-yes <%= (myResponse && myResponse.status === 'yes') ? 'active' : '' %>"
            data-mode="yes"
            <%= !canEdit ? 'disabled' : '' %>
          >
            ✓ Yes, I'll be there
          </button>
          <button
            type="button"
            class="btn-status btn-no <%= (myResponse && myResponse.status === 'no') ? 'active' : '' %>"
            data-mode="no"
            <%= !canEdit ? 'disabled' : '' %>
          >
            ✕ Can't make it
          </button>
          <button
            type="button"
            class="btn-status btn-maybe <%= (myResponse && myResponse.status === 'maybe') ? 'active' : '' %>"
            data-mode="maybe"
            <%= !canEdit ? 'disabled' : '' %>
          >
            ? Not sure yet
          </button>
        <% } %>
      </div>

      <% if (householdInvite && !pairInvite) { %>
        <div
          class="party-selector <%= householdPartialSelected ? '' : 'party-selector-hidden' %>"
          id="attendee-selector"
        >
          <label class="comment-label">Who will attend?</label>
          <p class="party-selector-copy">
            <% if (participantPartyMembers.length === 2) { %>
              Choose the person who can make it. Anyone left unchecked will be marked as not attending.
            <% } else { %>
              Choose everyone who can make it. Anyone left unchecked will be marked as not attending.
            <% } %>
          </p>
          <div class="party-selector-grid">
            <% participantPartyMembers.forEach(function(name) { %>
              <label class="party-checkbox">
                <input
                  type="checkbox"
                  class="attendee-checkbox"
                  value="<%= name %>"
                  <%= selectedAttendeeNames.includes(name) ? 'checked' : '' %>
                  <%= !canEdit ? 'disabled' : '' %>
                >
                <span><%= name %></span>
              </label>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="comment-wrap" id="comment-wrap">
        <label for="comment-input" class="comment-label">Add a note (optional)</label>
        <textarea
          id="comment-input"
          class="comment-input"
          maxlength="400"
          placeholder="e.g. Running 10 minutes late..."
          <%= !canEdit ? 'disabled' : '' %>
        ><%= (myResponse && myResponse.comment) ? myResponse.comment : '' %></textarea>
        <div class="char-counter"><span id="char-count"><%= (myResponse && myResponse.comment) ? myResponse.comment.length : 0 %></span> / 400</div>
      </div>

      <button
        type="button"
        class="btn-submit"
        id="submit-btn"
        <%= canEdit ? 'disabled' : 'disabled' %>
        aria-label="Submit your RSVP"
      >
        Save RSVP
      </button>

      <div class="rsvp-feedback" id="rsvp-feedback" aria-live="polite"></div>

      <div class="current-rsvp" id="current-rsvp">
        <span class="current-label">Current response:</span>
        <span class="current-status <%= currentStatusClass %>" id="current-rsvp-status"><%= currentStatusText %></span>
        <span class="current-detail" id="current-rsvp-detail"><%= currentDetailText %></span>
      </div>

      <p class="changes-note <%= canEdit ? '' : 'limit-reached' %>" id="changes-note">
        <% if (canEdit) { %>
          You can update this RSVP until the event starts on <strong><%= eventStartLabel %></strong>.
        <% } else { %>
          RSVP changes closed when the event started on <strong><%= eventStartLabel %></strong>.
        <% } %>
      </p>
    </section>

  </div><!-- /.rsvp-left -->

  <!-- RIGHT COLUMN: roster -->
  <div class="rsvp-right">
    <section class="card roster-card">
      <h3 class="roster-heading">Who's Coming</h3>

      <div class="roster-counts" id="roster-counts">
        <%
          const counts = { yes: 0, no: 0, maybe: 0, none: 0 };
          roster.forEach(r => {
            counts.yes += r.attendeeNames.length;
            counts.no += r.declinedNames.length;
            counts.maybe += r.maybeNames.length;
            counts.none += r.pendingNames.length;
          });
        %>
        <span class="count-badge count-yes" title="Yes"><%= counts.yes %> Yes</span>
        <span class="count-badge count-maybe" title="Maybe"><%= counts.maybe %> Maybe</span>
        <span class="count-badge count-no" title="No"><%= counts.no %> No</span>
        <span class="count-badge count-none" title="Not yet responded"><%= counts.none %> Pending</span>
      </div>

      <ul class="roster-list" id="roster-list">
        <% roster.forEach(function(p) { %>
          <li class="roster-item roster-<%= p.status || 'none' %> <%= p.id === participant.id ? 'roster-mine' : '' %>"
              data-pid="<%= p.id %>">
            <span class="roster-name">
              <%= p.name %>
              <% if (p.id === participant.id) { %><span class="you-badge">You</span><% } %>
            </span>
            <span class="roster-status">
              <% if (p.status === 'yes') { %>
                <span class="status-pill pill-yes">✓ Yes</span>
              <% } else if (p.status === 'no') { %>
                <span class="status-pill pill-no">✕ No</span>
              <% } else if (p.status === 'maybe') { %>
                <span class="status-pill pill-maybe">? Maybe</span>
              <% } else { %>
                <span class="status-pill pill-none">—</span>
              <% } %>
            </span>
            <% if (p.status === 'yes') { %>
              <span class="roster-detail">
                Coming: <%= joinNames(p.attendeeNames) %><% if (p.declinedNames.length > 0) { %>. Not attending: <%= joinNames(p.declinedNames) %><% } %>.
              </span>
            <% } else if (p.status === 'maybe') { %>
              <span class="roster-detail">Still deciding for <%= joinNames(p.partyMembers) %>.</span>
            <% } else if (p.status === 'no') { %>
              <span class="roster-detail">Not attending: <%= joinNames(p.partyMembers) %>.</span>
            <% } else if (p.partySize > 1) { %>
              <span class="roster-detail">Waiting on <%= joinNames(p.partyMembers) %>.</span>
            <% } %>
            <% if (p.comment) { %>
              <span class="roster-comment">"<%= p.comment %>"</span>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </section>
  </div><!-- /.rsvp-right -->

</main>

<footer class="site-footer">
  <% if (publicEventPath) { %>
    <a href="<%= publicEventPath %>">View event page</a>
  <% } %>
</footer>

<script>
  const MY_PID    = <%= participant.id %>;
  const RSVP_POST_PATH = <%- JSON.stringify(rsvpPath) %>;
  const CAN_EDIT = <%= canEdit ? 'true' : 'false' %>;
  const PARTY_MEMBERS = <%- JSON.stringify(participantPartyMembers) %>;
  const INITIAL_ATTENDEE_NAMES = <%- JSON.stringify(selectedAttendeeNames) %>;
  let selectedStatus = '<%= (myResponse && myResponse.status) ? myResponse.status : '' %>';
</script>
<script src="/js/rsvp.js"></script>
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  }
</script>
</body>
</html>
