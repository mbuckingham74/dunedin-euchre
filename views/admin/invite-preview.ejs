<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Invite Preview</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'dashboard' }) %>

<main class="admin-main">
  <div class="admin-content">

    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <section class="card admin-card">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Invite Preview</h2>
          <p class="admin-card-copy">This page shows the exact RSVP experience invitees will see. When it looks right, confirm and send from here.</p>
        </div>
      </div>

      <div class="testing-alert" style="margin-bottom:1rem;">
        <strong>Previewing now:</strong> <%= getEventTitle(event) %> on <%= formatEventDate(event.event_date) %> at <%= formatTime(event.start_time) %>.
      </div>

      <div class="dashboard-note" style="margin-bottom:1rem;">
        <span class="notes-label">Reminder email</span>
        <p class="notes-text">
          <strong><%= getReminderStatusLabel(reminderSummary) %></strong><br>
          Default send time:
          <strong><%= formatReminderTimestamp(defaultReminderSchedule.scheduledAt) %></strong>
          for all invitees who already received the original event invite.
        </p>
      </div>

      <div class="invite-preview-toolbar">
        <a href="<%= editDashboardPath %>" class="btn-secondary">Back to Edit Event</a>
        <a href="<%= inviteStatusPath %>" class="btn-secondary">Invite Delivery</a>
        <form
          method="POST"
          action="<%= reminderSchedulePath %>"
          onsubmit="return confirm('Queue the reminder email for <%= formatReminderTimestamp(defaultReminderSchedule.scheduledAt) %>?')"
        >
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <button type="submit" class="btn-secondary">Queue Day-Before Reminder</button>
        </form>
        <form
          method="POST"
          action="/admin/event/<%= event.id %>/notify"
          onsubmit="return confirm('Send RSVP emails now to all <%= inviteParticipants.length %> active <%= inviteParticipants.length === 1 ? 'invitee' : 'invitees' %>?')"
        >
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <button type="submit" class="btn-primary">Confirm and send RSVP to <%= inviteParticipants.length %> <%= inviteParticipants.length === 1 ? 'invitee' : 'invitees' %></button>
        </form>
        <p class="dashboard-detail-meta invite-preview-meta">Invites send immediately. Reminder emails queue for the day before at 9:00 AM Pacific.</p>
      </div>

      <div class="invite-preview-shell">
        <aside class="card admin-card invite-preview-sidebar">
          <div class="card-header">
            <div class="admin-card-header-text">
              <h3 class="card-title">Preview As Invitee</h3>
              <p class="admin-card-copy">Switch between active invitees if you want to verify a different RSVP page.</p>
            </div>
          </div>

          <form method="GET" action="/admin/event/<%= event.id %>/invite-preview" class="testing-form-stack">
            <div class="form-group">
              <label class="form-label">Invitee</label>
              <select name="participantId" class="form-input">
                <% inviteParticipants.forEach(function(participant) { %>
                  <option value="<%= participant.id %>" <%= previewParticipant.id === participant.id ? 'selected' : '' %>>
                    <%= participant.name %> · <%= participant.email %>
                  </option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn-secondary">Refresh Preview</button>
          </form>

          <div class="dashboard-note" style="margin-top:1rem;">
            <span class="notes-label">Currently previewing</span>
            <p class="notes-text"><strong><%= previewParticipant.name %></strong><br><span style="font-family:system-ui,sans-serif;color:var(--gray-500);"><%= previewParticipant.email %></span></p>
          </div>
        </aside>

        <section class="card admin-card invite-preview-stage">
          <div class="card-header">
            <div class="admin-card-header-text">
              <h3 class="card-title">Invitee View</h3>
              <p class="admin-card-copy">The frame below loads the same RSVP page an invitee opens from their email.</p>
            </div>
          </div>

          <iframe
            title="Invite preview"
            src="<%= previewPath %>"
            class="invite-preview-frame"
            loading="lazy"
            referrerpolicy="no-referrer"
          ></iframe>
        </section>
      </div>
    </section>
  </div>
</main>

<script src="/js/admin.js"></script>
</body>
</html>
