<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Events</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'events' }) %>

<main class="admin-main">
  <div class="admin-content">
    <% const nextScheduledEntry = upcomingEntries[0] || null; %>

    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <section class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Recurring Event Schedule</h2>
          <p class="admin-card-copy">
            Every event lands on the fourth Saturday of the month. Showing scheduled dates through
            <strong><%= endDateKey ? formatEventDate(endDateKey) : 'the next year' %></strong>.
          </p>
        </div>
      </div>

      <div class="admin-history-summary-grid">
        <div class="admin-history-summary-box">
          <span class="admin-history-summary-label">Pattern</span>
          <strong>4th Saturday</strong>
        </div>
        <div class="admin-history-summary-box">
          <span class="admin-history-summary-label">Next scheduled date</span>
          <strong><%= nextScheduledEntry ? nextScheduledEntry.formattedDate : 'No upcoming date' %></strong>
        </div>
        <div class="admin-history-summary-box">
          <span class="admin-history-summary-label">Coverage</span>
          <strong>
            <%= startDateKey ? formatEventDate(startDateKey) : 'Today' %>
            to
            <%= endDateKey ? formatEventDate(endDateKey) : 'next year' %>
          </strong>
        </div>
      </div>
    </section>

    <section class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Upcoming Schedule</h2>
          <p class="admin-card-copy">These are the next 12 scheduled event dates, including today if tonight's game has not happened yet.</p>
        </div>
      </div>

      <% if (upcomingEntries.length === 0) { %>
        <p class="admin-card-copy">No upcoming dates available.</p>
      <% } else { %>
        <div class="admin-history-list">
          <% upcomingEntries.forEach(function(entry) { %>
            <article class="admin-history-item" id="scheduled-<%= entry.dateKey %>">
              <div class="admin-history-date">
                <span class="admin-history-date-label">Scheduled date</span>
                <strong><%= entry.formattedDate %></strong>
                <div class="admin-history-pill-row">
                  <% if (entry.isToday) { %>
                    <span class="status-pill pill-maybe">Tonight</span>
                  <% } else { %>
                    <span class="status-pill pill-none">Upcoming</span>
                  <% } %>
                  <% if (entry.hasEvent) { %>
                    <span class="status-pill <%= isEventPublished(entry.primaryEvent) ? 'pill-yes' : 'pill-none' %>">
                      <%= isEventPublished(entry.primaryEvent) ? 'Published' : 'Draft' %>
                    </span>
                  <% } else { %>
                    <span class="status-pill pill-none">Not created</span>
                  <% } %>
                </div>
              </div>

              <div class="admin-history-details">
                <% if (entry.hasEvent) { %>
                  <% entry.events.forEach(function(event) { %>
                    <div class="admin-history-event">
                      <div class="admin-history-event-header">
                        <h3 class="admin-history-event-title"><%= getEventTitle(event) %></h3>
                      </div>
                      <p class="admin-history-meta"><%= event.location_name %> · <%= formatTime(event.start_time) %> - <%= formatTime(event.end_time) %></p>
                      <p class="admin-history-meta">
                        <%= event.yes_count %> yes · <%= event.maybe_count %> maybe · <%= event.no_count %> no
                      </p>
                      <div class="admin-actions">
                        <a href="/admin/dashboard?eventId=<%= event.id %>" class="btn-sm btn-secondary">Open in dashboard</a>
                        <% if (isEventPublished(event)) { %>
                          <a href="<%= buildPublicEventPath(event) %>" target="_blank" class="btn-sm btn-secondary">View public page</a>
                        <% } %>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <p class="admin-history-empty">No event record has been created for this scheduled date yet.</p>
                  <div class="admin-actions">
                    <% if (locations.length > 0) { %>
                      <button
                        type="button"
                        class="btn-sm btn-secondary"
                        onclick="toggleScheduledCreateForm('create-form-<%= entry.dateKey %>')"
                      >
                        Create event
                      </button>
                    <% } else { %>
                      <a href="/admin/locations" class="btn-sm btn-secondary">Add a location first</a>
                    <% } %>
                  </div>
                  <% if (locations.length > 0) { %>
                    <div
                      id="create-form-<%= entry.dateKey %>"
                      class="scheduled-create-form"
                      style="display:<%= activeCreateDate === entry.dateKey ? 'block' : 'none' %>;"
                    >
                      <form method="POST" action="/admin/event" class="scheduled-create-card">
                        <input type="hidden" name="return_to" value="events">
                        <input type="hidden" name="title" value="Dunedin Euchre Night">
                        <input type="hidden" name="public_slug" value="">
                        <input type="hidden" name="event_date" value="<%= entry.dateKey %>">
                        <input type="hidden" name="start_time" value="18:00">
                        <input type="hidden" name="end_time" value="21:00">

                        <div class="scheduled-create-grid">
                          <div class="form-group">
                            <label class="form-label">Scheduled date</label>
                            <input
                              type="text"
                              class="form-input"
                              value="<%= entry.formattedDate %>"
                              readonly
                            >
                          </div>

                          <div class="form-group">
                            <label class="form-label">Location</label>
                            <select name="location_id" class="form-input" required>
                              <option value="">Select a saved location</option>
                              <% locations.forEach(function(location) { %>
                                <option value="<%= location.id %>"><%= location.name %></option>
                              <% }); %>
                            </select>
                          </div>
                        </div>

                        <div class="form-group" style="margin-top:0.75rem;">
                          <label class="form-label">Arrival / parking notes <span style="font-weight:400;color:#64748b;">(optional)</span></label>
                          <textarea
                            name="arrival_notes"
                            class="form-input"
                            rows="3"
                            placeholder="e.g. Park in Lot B and use the west entrance."
                          ></textarea>
                        </div>

                        <p class="scheduled-create-note">This quick-create form uses the standard 6:00 PM to 9:00 PM event window. You can change times, title, and publishing settings later from the dashboard if needed.</p>

                        <div class="admin-actions" style="margin-top:0.85rem;">
                          <button type="submit" class="btn-sm btn-primary">Create Event</button>
                          <button
                            type="button"
                            class="btn-sm btn-secondary"
                            onclick="toggleScheduledCreateForm('create-form-<%= entry.dateKey %>')"
                          >
                            Cancel
                          </button>
                        </div>
                      </form>
                    </div>
                  <% } %>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

    <section class="card admin-card">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Past Event History</h2>
          <p class="admin-card-copy">Every scheduled fourth Saturday back to the first recorded event. Gaps stay visible so missing records are obvious.</p>
        </div>
      </div>

      <% if (pastEntries.length === 0) { %>
        <p class="admin-card-copy">No past event dates to show yet.</p>
      <% } else { %>
        <div class="admin-history-list">
          <% pastEntries.slice().reverse().forEach(function(entry) { %>
            <article class="admin-history-item admin-history-item-past">
              <div class="admin-history-date">
                <span class="admin-history-date-label">Event date</span>
                <strong><%= entry.formattedDate %></strong>
                <div class="admin-history-pill-row">
                  <span class="status-pill pill-none">Past</span>
                  <% if (entry.hasEvent) { %>
                    <span class="status-pill <%= isEventPublished(entry.primaryEvent) ? 'pill-yes' : 'pill-none' %>">
                      <%= isEventPublished(entry.primaryEvent) ? 'Published' : 'Draft' %>
                    </span>
                  <% } else { %>
                    <span class="status-pill pill-no">Missing record</span>
                  <% } %>
                </div>
              </div>

              <div class="admin-history-details">
                <% if (entry.hasEvent) { %>
                  <% entry.events.forEach(function(event) { %>
                    <div class="admin-history-event">
                      <div class="admin-history-event-header">
                        <h3 class="admin-history-event-title"><%= getEventTitle(event) %></h3>
                      </div>
                      <p class="admin-history-meta"><%= event.location_name %> · <%= formatTime(event.start_time) %> - <%= formatTime(event.end_time) %></p>
                      <p class="admin-history-meta">
                        <%= event.yes_count %> yes · <%= event.maybe_count %> maybe · <%= event.no_count %> no
                      </p>
                      <div class="admin-actions">
                        <a href="/admin/dashboard?eventId=<%= event.id %>" class="btn-sm btn-secondary">Open in dashboard</a>
                        <% if (isEventPublished(event)) { %>
                          <a href="<%= buildPublicEventPath(event) %>" target="_blank" class="btn-sm btn-secondary">View public page</a>
                        <% } %>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <p class="admin-history-empty">No saved event was found for this regularly scheduled date.</p>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

  </div>
</main>

<script>
function toggleScheduledCreateForm(id) {
  const forms = document.querySelectorAll('.scheduled-create-form');
  const target = document.getElementById(id);
  if (!target) return;

  const shouldOpen = target.style.display === 'none';
  forms.forEach(form => {
    form.style.display = 'none';
  });

  if (shouldOpen) {
    target.style.display = 'block';
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}
</script>
<script src="/js/admin.js"></script>
</body>
</html>
