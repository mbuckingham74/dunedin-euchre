<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Edit Event</title>
  <link rel="stylesheet" href="<%= assetPath('/css/styles.css') %>">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'dashboard' }) %>

<main class="admin-main">
  <div class="admin-content">

    <% if (flash) { %>
      <% const flashMessage = typeof flash === 'string' ? flash : flash.message; %>
      <% const flashTone = flash && flash.type === 'error' ? ' flash-msg-error' : ''; %>
      <div class="flash-msg<%= flashTone %>"><%= flashMessage %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <section class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Edit Event</h2>
          <p class="admin-card-copy">Update the event details, review the invitee list, then preview or send the RSVP invite.</p>
        </div>
      </div>

      <div class="testing-alert" style="margin-bottom:1rem;">
        <strong>Editing now:</strong> <%= getEventTitle(event) %> on <%= formatEventDate(event.event_date) %> at <%= formatTime(event.start_time) %>.
      </div>

      <div class="invite-preview-toolbar">
        <a href="<%= dashboardPath %>" class="btn-secondary">Back to Dashboard</a>
        <a href="<%= participantsPath %>" class="btn-secondary">Manage Invitees</a>
        <% if (inviteParticipants.length > 0) { %>
          <a href="<%= invitePreviewPath %>" class="btn-secondary">Invite Preview</a>
          <a href="<%= inviteStatusPath %>" class="btn-secondary">Invite Delivery</a>
        <% } %>
        <% if (isEventPublished(event)) { %>
          <a href="<%= buildPublicEventPath(event) %>" target="_blank" rel="noopener noreferrer" class="btn-secondary">Open Event Page</a>
        <% } %>
      </div>
    </section>

    <% const respondedCount = counts.yes + counts.maybe + counts.no; %>
    <% const publicPath = buildPublicEventPath(event); %>

    <div class="dashboard-grid">
      <section class="card admin-card dashboard-card dashboard-card-main">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h3 class="card-title">Event Details</h3>
            <p class="admin-card-copy">These settings control what invitees see and where the RSVP links point.</p>
          </div>
        </div>

        <form method="POST" action="/admin/event/<%= event.id %>/update">
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <%- include('../partials/event-form', { event: event, locations: locations }) %>
          <div class="admin-actions" style="margin-top:1rem;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <% if (inviteParticipants.length > 0) { %>
              <button type="submit" name="next_action" value="preview" class="btn-secondary">Save And Open Invite Preview</button>
            <% } %>
            <a href="<%= dashboardPath %>" class="btn-secondary">Cancel</a>
          </div>
        </form>
      </section>

      <section class="card admin-card dashboard-card dashboard-card-side">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h3 class="card-title">Invite Snapshot</h3>
            <p class="admin-card-copy">Everything needed to sanity-check this event before invites go out.</p>
          </div>
        </div>

        <div class="admin-counts dashboard-counts" style="margin-bottom:1rem;">
          <div class="admin-count-box count-yes"><span class="count-num"><%= counts.yes %></span><span class="count-lbl">Yes</span></div>
          <div class="admin-count-box count-maybe"><span class="count-num"><%= counts.maybe %></span><span class="count-lbl">Maybe</span></div>
          <div class="admin-count-box count-no"><span class="count-num"><%= counts.no %></span><span class="count-lbl">No</span></div>
          <div class="admin-count-box count-none"><span class="count-num"><%= counts.none %></span><span class="count-lbl">No response</span></div>
        </div>

        <div class="dashboard-note" style="margin-bottom:1rem;">
          <span class="notes-label">Invitees</span>
          <p class="notes-text">
            <strong><%= inviteParticipants.length %></strong> active invitee<%= inviteParticipants.length === 1 ? '' : 's' %> are on this event.
            <br>
            <strong><%= respondedCount %></strong> have responded so far.
          </p>
        </div>

        <div class="dashboard-detail-grid">
          <article class="dashboard-detail-card">
            <p class="dashboard-detail-label">When</p>
            <p class="dashboard-detail-value"><%= formatEventDate(event.event_date) %></p>
            <p class="dashboard-detail-meta"><%= formatTime(event.start_time) %> – <%= formatTime(event.end_time) %></p>
          </article>

          <article class="dashboard-detail-card">
            <p class="dashboard-detail-label">Where</p>
            <p class="dashboard-detail-value"><%= event.location_name %></p>
            <% if (event.location_address) { %>
              <p class="dashboard-detail-meta dashboard-detail-multiline"><%= event.location_address %></p>
            <% } %>
          </article>

          <article class="dashboard-detail-card">
            <p class="dashboard-detail-label">Event Page</p>
            <% if (isEventPublished(event)) { %>
              <a href="<%= publicPath %>" target="_blank" rel="noopener noreferrer" class="rsvp-link-preview"><%= baseUrl + publicPath %></a>
            <% } else { %>
              <p class="dashboard-detail-meta">Draft only. Publish the event page before sharing it publicly.</p>
            <% } %>
            <% if (event.public_slug) { %>
              <p class="dashboard-detail-meta">Active slug: <code><%= event.public_slug %></code></p>
            <% } else if (publicSlugHistory.length > 0) { %>
              <p class="dashboard-detail-meta">No active slug. The event ID fallback URL is in use.</p>
            <% } %>
          </article>
        </div>

        <% if (previousPublicSlugs.length > 0) { %>
          <div class="dashboard-note" style="margin-top:1rem;">
            <span class="notes-label">Older Event URLs</span>
            <div class="dashboard-link-list">
              <% previousPublicSlugs.forEach(function(entry) { %>
                <div>
                  <a href="/e/<%= entry.slug %>" target="_blank" rel="noopener noreferrer" class="rsvp-link-preview"><%= baseUrl %>/e/<%= entry.slug %></a>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <form
          method="POST"
          action="/admin/event/<%= event.id %>/delete"
          style="margin-top:1rem;"
          onsubmit="return confirm('Delete this event and all of its RSVP responses? This cannot be undone.')"
        >
          <input type="hidden" name="_csrf" value="<%= _csrf %>">
          <button type="submit" class="btn-secondary btn-danger">Delete Event</button>
        </form>
      </section>
    </div>

    <section class="card admin-card" style="margin-top:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h3 class="card-title">People Invited To This Event</h3>
          <p class="admin-card-copy">This is the live invitee list for the selected event, along with the current RSVP status for each invite.</p>
        </div>
      </div>

      <% if (inviteParticipants.length > 0) { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Invitees</th>
                <th>Current RSVP</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% inviteParticipants.forEach(function(participant) { %>
                <tr>
                  <td><%= participant.name %></td>
                  <td><a href="mailto:<%= participant.email %>" class="admin-email-link"><%= participant.email %></a></td>
                  <td>
                    <div><%= participant.partyMembers.join(', ') %></div>
                    <div class="dashboard-detail-meta" style="margin-top:0.2rem;"><%= participant.partyMembers.length %> invitee<%= participant.partyMembers.length === 1 ? '' : 's' %></div>
                  </td>
                  <td>
                    <div class="participant-response-summary">
                      <span class="status-pill <%= getParticipantResponseTone(participant.currentResponse) %>"><%= getParticipantResponseLabel(participant.currentResponse) %></span>
                      <div class="participant-response-copy">
                        <div class="participant-response-detail"><%= getParticipantResponseDetail(participant.currentResponse) %></div>
                        <% if (participant.currentResponse && participant.currentResponse.updated_at) { %>
                          <div class="participant-response-meta">Updated <%= formatResponseUpdatedAt(participant.currentResponse.updated_at) %></div>
                        <% } %>
                      </div>
                    </div>
                  </td>
                  <td class="actions-cell">
                    <a href="/admin/event/<%= event.id %>/preview?participantId=<%= participant.id %>" target="_blank" rel="noopener noreferrer" class="btn-sm btn-secondary">Preview RSVP</a>
                    <a href="<%= participantsPath %>#participant-<%= participant.id %>" class="btn-sm btn-secondary">Manage RSVP</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="dashboard-empty-state">
          <p class="dashboard-empty-title">No invitees are on this event yet.</p>
          <p class="admin-card-copy">Add people to the roster before previewing or sending invites.</p>
          <div class="admin-actions" style="margin-top:1rem;">
            <a href="<%= participantsPath %>" class="btn-secondary">Open Invitee List</a>
          </div>
        </div>
      <% } %>
    </section>
  </div>
</main>

<script src="<%= assetPath('/js/admin.js') %>"></script>
</body>
</html>
