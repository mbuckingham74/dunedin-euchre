<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Admin Sign In</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body { background: #f1f5f9; }
    .login-wrap {
      max-width: 420px;
      margin: 6rem auto;
      padding: 0 1.5rem;
    }
    .login-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 0.5rem;
    }
    .login-sub {
      font-size: 1rem;
      color: #64748b;
      margin-bottom: 2rem;
    }
    .sent-box {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 8px;
      padding: 1.5rem;
      font-size: 1.05rem;
      color: #15803d;
      line-height: 1.6;
    }
    .error-box {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 1rem 1.25rem;
      font-size: 1rem;
      color: #b91c1c;
      margin-bottom: 1.25rem;
    }
  </style>
</head>
<body>
<div class="login-wrap">
  <p class="login-title">&#9830; Dunedin Euchre</p>
  <p class="login-sub">Admin sign in</p>

  <% if (sent) { %>
    <div class="sent-box">
      <strong>Check your email.</strong><br><br>
      We've sent a sign-in link to your email address.
      It expires in 15 minutes — click it to access the dashboard.
    </div>
  <% } else { %>
    <div class="card" style="padding:2rem;">
      <% if (error) { %>
        <div class="error-box"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/request-link">
        <div class="form-group">
          <label for="email" class="form-label">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="your@email.com"
            required
            autofocus
          >
        </div>
        <button type="submit" class="btn-primary" style="width:100%;margin-top:0.5rem;">
          Send sign-in link
        </button>
      </form>
    </div>
  <% } %>
</div>
</body>
</html>
