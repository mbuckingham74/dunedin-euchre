<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Locations</title>
  <link rel="stylesheet" href="<%= assetPath('/css/styles.css') %>">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'locations' }) %>

<main class="admin-main">
  <div class="admin-content">
    <% const hasLocations = locations.length > 0; %>
    <% const createFormVisible = !hasLocations || showCreateForm; %>
    <% const addLocationLabel = hasLocations ? 'Add Location' : 'Add First Location'; %>

    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <section class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Saved Locations</h2>
          <p class="admin-card-copy"><%= locations.length %> saved location<%= locations.length === 1 ? '' : 's' %> available to the event form dropdown.</p>
        </div>
        <button
          type="button"
          class="btn-primary"
          data-location-form-toggle
          aria-controls="location-create-form-card"
          aria-expanded="<%= createFormVisible ? 'true' : 'false' %>"
        >
          <%= addLocationLabel %>
        </button>
      </div>

      <% if (!hasLocations) { %>
        <div class="locations-empty-state">
          <p class="admin-card-copy">No saved locations yet. Add the first venue below so it can be reused from the event form dropdown.</p>
        </div>
      <% } else { %>
        <div class="locations-list">
          <% locations.forEach(function(location) { %>
            <article class="location-card">
              <div class="location-card-header">
                <div>
                  <h3 class="location-card-title"><%= location.name %></h3>
                  <p class="location-card-meta"><%= location.event_count %> event<%= location.event_count === 1 ? '' : 's' %> currently use this location.</p>
                </div>
              </div>

              <div class="location-card-body">
                <div class="location-card-preview">
                  <p class="location-preview-address"><%= location.address %></p>

                  <% if (location.location_image || location.map_embed_url) { %>
                    <div class="event-media-grid" style="margin-top:1rem;">
                      <% if (location.location_image) { %>
                        <div class="event-media-card">
                          <p class="location-image-caption">Venue photo</p>
                          <img src="/uploads/<%= location.location_image %>" alt="<%= location.name %>" class="location-image">
                        </div>
                      <% } %>
                      <% if (location.map_embed_url) { %>
                        <div class="event-media-card">
                          <div class="event-media-card-header">
                            <p class="location-image-caption">Map</p>
                            <% if (location.map_link_url) { %>
                              <a href="<%= location.map_link_url %>" target="_blank" rel="noreferrer" class="event-map-link">Open map</a>
                            <% } %>
                          </div>
                          <iframe
                            src="<%= location.map_embed_url %>"
                            title="Map for <%= location.name %>"
                            class="event-map-embed"
                            loading="lazy"
                            referrerpolicy="no-referrer"
                          ></iframe>
                        </div>
                      <% } %>
                    </div>
                  <% } %>
                </div>

                <form method="POST" action="/admin/locations/<%= location.id %>/update" enctype="multipart/form-data" class="location-card-form">
                  <input type="hidden" name="_csrf" value="<%= _csrf %>">
                  <div class="form-group">
                    <label class="form-label">Location name</label>
                    <input
                      type="text"
                      name="name"
                      class="form-input"
                      required
                      value="<%= location.name %>"
                    >
                  </div>

                  <div class="form-group" style="margin-top:0.75rem;">
                    <label class="form-label">Address</label>
                    <textarea
                      name="address"
                      class="form-input"
                      rows="3"
                      required
                    ><%= location.address %></textarea>
                  </div>

                  <div class="form-group" style="margin-top:0.75rem;">
                    <label class="form-label">Venue photo <span style="font-weight:400;color:var(--gray-500);">(optional)</span></label>
                    <% if (location.location_image) { %>
                      <div class="event-upload-preview">
                        <img src="/uploads/<%= location.location_image %>" alt="Current venue photo" class="event-upload-preview-image">
                        <span class="event-upload-preview-text">Upload a new photo to replace this one, or remove it below.</span>
                      </div>
                      <label class="form-checkbox" style="margin-top:0.5rem;">
                        <input type="checkbox" name="remove_location_image" value="1">
                        <span>Remove current venue photo</span>
                      </label>
                    <% } %>
                    <input type="file" name="location_image" class="form-input" accept="image/*">
                  </div>

                  <div class="admin-actions" style="margin-top:1rem;">
                    <button type="submit" class="btn-primary">Update Location</button>
                    <button
                      type="submit"
                      class="btn-secondary btn-danger"
                      formaction="/admin/locations/<%= location.id %>/delete"
                      formmethod="POST"
                      formenctype="application/x-www-form-urlencoded"
                      onclick="return confirm('Delete this saved location? Existing events will keep their current venue details.')"
                    >
                      Delete Location
                    </button>
                  </div>

                  <% if (location.event_count > 0) { %>
                    <p class="location-delete-note">
                      This location is already linked to <%= location.event_count %> event<%= location.event_count === 1 ? '' : 's' %>. Deleting it removes it from the dropdown, but those saved events keep their current venue snapshot.
                    </p>
                  <% } %>
                </form>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>

    <section
      id="location-create-form-card"
      class="card admin-card location-create-card"
      style="margin-bottom:1.5rem;"
      data-location-create-card
      <%= createFormVisible ? '' : 'hidden' %>
    >
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Location Manager</h2>
          <p class="admin-card-copy">Save a venue once, then pick it from the event form dropdown. The map embed is generated from the address and framed to roughly a one-mile view.</p>
        </div>
      </div>

      <form method="POST" action="/admin/locations" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Location name</label>
            <input
              type="text"
              name="name"
              class="form-input"
              required
              placeholder="e.g. Dunedin Community Center"
              data-location-create-name
            >
          </div>
          <div class="form-group">
            <label class="form-label">Venue photo <span style="font-weight:400;color:var(--gray-500);">(optional)</span></label>
            <input type="file" name="location_image" class="form-input" accept="image/*">
          </div>
        </div>

        <div class="form-group" style="margin-top:0.75rem;">
          <label class="form-label">Address</label>
          <textarea
            name="address"
            class="form-input"
            rows="3"
            required
            placeholder="e.g. 123 Main St&#10;Dunedin, FL 34698"
            data-location-address-input
          ></textarea>
          <p style="margin:0.45rem 0 0;font-size:0.9rem;color:var(--gray-500);">This address drives the embedded map and the “Open map” link used on event pages.</p>
        </div>

        <div class="location-preview-card" data-address-preview hidden>
          <div class="location-preview-copy">
            <p class="location-preview-label">Map preview</p>
            <p class="location-preview-address" data-address-preview-text></p>
            <a href="#" target="_blank" rel="noreferrer" class="event-map-link" data-address-preview-link hidden>Open map</a>
          </div>
          <iframe
            src=""
            title="Location map preview"
            class="event-map-embed location-preview-map"
            data-address-preview-map
            loading="lazy"
            referrerpolicy="no-referrer"
          ></iframe>
        </div>

        <button type="submit" class="btn-primary" style="margin-top:1rem;">Save Location</button>
      </form>
    </section>

  </div>
</main>

<script src="<%= assetPath('/js/admin.js') %>"></script>
</body>
</html>
