<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Email Notifications</title>
  <link rel="stylesheet" href="<%= assetPath('/css/styles.css') %>">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'notifications' }) %>

<main class="admin-main">
  <div class="admin-content">
    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <section class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h1 class="card-title">Email Notifications</h1>
          <p class="admin-card-copy">A plain-language guide to every email the site sends, including its sender, audience, frequency, and local delivery time.</p>
        </div>
      </div>

      <div class="notification-time-note">
        <strong>Florida local time:</strong> scheduled event emails use Eastern Time and automatically follow daylight-saving time.
      </div>

      <div class="notification-list">
        <% notifications.forEach(function(notification) { %>
          <article id="notification-<%= notification.type %>" class="notification-card admin-anchor-section">
            <div class="notification-card-header">
              <h2 class="notification-card-title"><%= notification.name %></h2>
              <div class="notification-card-header-actions">
                <button
                  type="button"
                  class="btn-secondary btn-sm"
                  aria-controls="notification-editor-<%= notification.type %>"
                  aria-expanded="false"
                  data-notification-edit-toggle
                >
                  Edit
                </button>
                <span class="status-pill pill-none"><%= notification.mode %></span>
              </div>
            </div>

            <dl class="notification-details">
              <div class="notification-detail">
                <dt>From address</dt>
                <dd><code><%= notification.from %></code></dd>
              </div>
              <div class="notification-detail">
                <dt>Sent to</dt>
                <dd><%= notification.recipients %></dd>
              </div>
              <div class="notification-detail">
                <dt>Frequency</dt>
                <dd><%= notification.frequency %></dd>
              </div>
              <div class="notification-detail">
                <dt>Local delivery time</dt>
                <dd><strong><%= notification.timing %></strong></dd>
              </div>
            </dl>

            <div
              id="notification-editor-<%= notification.type %>"
              class="notification-editor"
              data-notification-editor
              hidden
            >
              <div class="notification-copy-note">
                Edit this email below. Text is safely escaped; use <code>{{eventTitle}}</code> for the current event name.
              </div>

              <form method="POST" action="/admin/notifications/copy" class="notification-copy-form">
                <input type="hidden" name="_csrf" value="<%= _csrf %>">
                <input type="hidden" name="notification_type" value="<%= notification.type %>">

                <% notification.copyFields.forEach(function(field) { %>
                  <div class="form-group notification-copy-field">
                    <label class="form-label" for="notification-copy-<%= notification.type %>-<%= field.key %>"><%= field.label %></label>
                    <textarea
                      id="notification-copy-<%= notification.type %>-<%= field.key %>"
                      name="<%= field.key %>"
                      class="form-input"
                      rows="<%= field.key === 'no_reply_notice' || field.key === 'reminder_message' ? 4 : 3 %>"
                      maxlength="<%= maxCopyLength %>"
                    ><%= copy[field.key] %></textarea>
                    <p class="form-help"><%= field.description %> Maximum <%= maxCopyLength %> characters.</p>
                  </div>
                <% }); %>

                <button type="submit" class="btn-primary">Save Wording</button>
              </form>

              <div class="notification-editor-secondary-actions">
                <form
                  method="POST"
                  action="/admin/notifications/reset-copy"
                  onsubmit="return confirm('Restore the original wording for this email?')"
                >
                  <input type="hidden" name="_csrf" value="<%= _csrf %>">
                  <input type="hidden" name="notification_type" value="<%= notification.type %>">
                  <button type="submit" class="btn-secondary">Restore Original</button>
                </form>
              </div>

              <div class="notification-test-box">
                <div>
                  <p class="notification-test-title">Send a test to admins only</p>
                  <p class="form-help">
                    This is sent only when you press the button, and only to
                    <%= adminRecipientCount === 1 ? 'the configured admin address' : `the ${adminRecipientCount} configured admin addresses` %>.
                    <%= notification.testHelp %>
                  </p>
                </div>
                <form
                  method="POST"
                  action="/admin/notifications/<%= notification.type %>/test"
                  onsubmit="return confirm('Send this test email to the configured admin addresses only?')"
                >
                  <input type="hidden" name="_csrf" value="<%= _csrf %>">
                  <button
                    type="submit"
                    class="btn-secondary"
                    <%= notification.testAvailable && adminRecipientCount > 0 ? '' : 'disabled' %>
                  >
                    Send Test to Admins
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>
  </div>
</main>

<script src="<%= assetPath('/js/admin.js') %>"></script>
</body>
</html>
