<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Dashboard</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'dashboard' }) %>

<main class="admin-main">
  <div class="admin-content">

    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <section class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Current Event</h2>
          <p class="admin-card-copy">Review the selected game, send invites, and make quick changes from one place.</p>
        </div>
        <div class="admin-actions">
          <a href="/admin/events" class="btn-secondary">Open Schedule</a>
          <button class="btn-primary" onclick="toggleForm('create-form')">+ New Event</button>
        </div>
      </div>

      <% if (allEvents.length > 0) { %>
        <form method="GET" action="/admin/dashboard" class="inline-form event-selector-form">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">View event</label>
              <select name="eventId" class="form-input">
                <% allEvents.forEach(function(item) { %>
                  <option value="<%= item.id %>" <%= selectedEventId === item.id ? 'selected' : '' %>>
                    <%= item.event_date %> · <%= getEventTitle(item) %>
                  </option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn-secondary" style="align-self:flex-end;">Load</button>
          </div>
        </form>
      <% } %>

      <% if (event) { %>
        <% const publicPath = buildPublicEventPath(event); %>
        <% const arrivalNotes = getArrivalNotes(event); %>
        <div class="event-meta" style="margin-bottom:1.5rem;">
          <div class="event-meta-row">
            <span class="meta-label">Title</span>
            <span class="meta-value"><strong><%= getEventTitle(event) %></strong></span>
          </div>
          <div class="event-meta-row">
            <span class="meta-label">Date</span>
            <span class="meta-value"><strong><%= formatEventDate(event.event_date) %></strong></span>
          </div>
          <div class="event-meta-row">
            <span class="meta-label">Location</span>
            <span class="meta-value"><%= event.location_name %></span>
          </div>
          <% if (event.location_address) { %>
            <div class="event-meta-row">
              <span class="meta-label">Address</span>
              <span class="meta-value meta-value-multiline"><%= event.location_address %></span>
            </div>
          <% } %>
          <div class="event-meta-row">
            <span class="meta-label">Time</span>
            <span class="meta-value"><%= formatTime(event.start_time) %> – <%= formatTime(event.end_time) %></span>
          </div>
          <div class="event-meta-row">
            <span class="meta-label">Public page</span>
            <span class="meta-value">
              <% if (isEventPublished(event)) { %>
                <span class="status-pill pill-yes">Published</span>
                <a href="<%= publicPath %>" target="_blank" class="rsvp-link-preview" style="margin-left:0.5rem;"><%= baseUrl + publicPath %></a>
              <% } else { %>
                <span class="status-pill pill-none">Draft</span>
              <% } %>
            </span>
          </div>
          <% if (event.public_slug) { %>
            <div class="event-meta-row">
              <span class="meta-label">Public slug</span>
              <span class="meta-value"><code><%= event.public_slug %></code></span>
            </div>
          <% } else if (publicSlugHistory.length > 0) { %>
            <div class="event-meta-row">
              <span class="meta-label">Public slug</span>
              <span class="meta-value" style="color:#64748b;">None active. Using the event ID fallback URL.</span>
            </div>
          <% } %>
          <% if (previousPublicSlugs.length > 0) { %>
            <div class="event-meta-row">
              <span class="meta-label">Older public URLs</span>
              <span class="meta-value meta-value-multiline">
                <% previousPublicSlugs.forEach(function(entry, index) { %>
                  <span style="display:block;<%= index > 0 ? 'margin-top:0.45rem;' : '' %>">
                    <a href="/e/<%= entry.slug %>" target="_blank" class="rsvp-link-preview"><%= baseUrl %>/e/<%= entry.slug %></a>
                    <% if (isEventPublished(event)) { %>
                      <span style="color:#64748b;"> redirects to the current public page.</span>
                    <% } else { %>
                      <span style="color:#64748b;"> stays reserved for this event while the page is draft.</span>
                    <% } %>
                  </span>
                <% }); %>
              </span>
            </div>
          <% } %>
          <div class="event-meta-row">
            <span class="meta-label">Public roster</span>
            <span class="meta-value">
              <% if (isPublicRosterVisible(event)) { %>
                <span class="status-pill pill-yes">Names visible</span>
              <% } else { %>
                <span class="status-pill pill-none">Names hidden</span>
              <% } %>
            </span>
          </div>
          <% if (arrivalNotes) { %>
            <div class="event-meta-row">
              <span class="meta-label">Arrival notes</span>
              <span class="meta-value meta-value-multiline"><%= arrivalNotes %></span>
            </div>
          <% } %>
        </div>

        <% if (event.location_image || event.map_embed_url || event.map_image) { %>
          <div class="event-media-grid admin-event-media-grid" style="margin-bottom:1.5rem;">
            <% if (event.location_image) { %>
              <div class="event-media-card">
                <p class="location-image-caption">Venue photo</p>
                <img src="/uploads/<%= event.location_image %>" alt="Venue photo" class="location-image">
              </div>
            <% } %>
            <% if (event.map_embed_url) { %>
              <div class="event-media-card">
                <div class="event-media-card-header">
                  <p class="location-image-caption">Map</p>
                  <% if (event.map_link_url) { %>
                    <a href="<%= event.map_link_url %>" target="_blank" rel="noreferrer" class="event-map-link">Open map</a>
                  <% } %>
                </div>
                <iframe
                  src="<%= event.map_embed_url %>"
                  title="Map for <%= getEventTitle(event) %>"
                  class="event-map-embed"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            <% } else if (event.map_image) { %>
              <div class="event-media-card">
                <p class="location-image-caption">Map image</p>
                <img src="/uploads/<%= event.map_image %>" alt="Map image" class="location-image">
              </div>
            <% } %>
          </div>
        <% } %>

        <div class="admin-counts">
          <div class="admin-count-box count-yes"><span class="count-num"><%= counts.yes %></span><span class="count-lbl">Yes</span></div>
          <div class="admin-count-box count-maybe"><span class="count-num"><%= counts.maybe %></span><span class="count-lbl">Maybe</span></div>
          <div class="admin-count-box count-no"><span class="count-num"><%= counts.no %></span><span class="count-lbl">No</span></div>
          <div class="admin-count-box count-none"><span class="count-num"><%= counts.none %></span><span class="count-lbl">No response</span></div>
        </div>

        <div class="admin-actions" style="margin-top:1.25rem;">
          <form method="POST" action="/admin/event/<%= event.id %>/notify"
                onsubmit="return confirm('Send RSVP invites to all <%= roster.length %> active participants?')">
            <button type="submit" class="btn-primary">
              &#128231; Send RSVP Invites (<%= roster.length %> participants)
            </button>
          </form>
          <% if (isEventPublished(event)) { %>
            <a href="<%= publicPath %>" target="_blank" class="btn-secondary">View public page</a>
          <% } %>
          <button class="btn-secondary" onclick="toggleForm('edit-form')">Edit event</button>
          <form
            method="POST"
            action="/admin/event/<%= event.id %>/delete"
            onsubmit="return confirm('Delete this event and all of its RSVP responses? This cannot be undone.')"
          >
            <button type="submit" class="btn-secondary btn-danger">Delete event</button>
          </form>
        </div>
      <% } else { %>
        <div class="dashboard-empty-state">
          <p class="dashboard-empty-title">No events scheduled yet.</p>
          <p class="admin-card-copy">Create the first event here, or use the schedule page to work from the recurring fourth-Saturday dates.</p>
        </div>
      <% } %>

      <div id="create-form" class="collapsible-form" style="display:none;">
        <hr style="margin:1.5rem 0;border-color:#e2e8f0;">
        <h3 style="margin-bottom:1rem;">Create New Event</h3>
        <form method="POST" action="/admin/event">
          <%- include('../partials/event-form', { event: null, locations: locations }) %>
          <button type="submit" class="btn-primary" style="margin-top:1rem;">Create Event</button>
          <button type="button" class="btn-secondary" onclick="toggleForm('create-form')">Cancel</button>
        </form>
      </div>

      <% if (event) { %>
        <div id="edit-form" class="collapsible-form" style="display:none;">
          <hr style="margin:1.5rem 0;border-color:#e2e8f0;">
          <h3 style="margin-bottom:1rem;">Edit Event</h3>
          <form method="POST" action="/admin/event/<%= event.id %>/update">
            <%- include('../partials/event-form', { event: event, locations: locations }) %>
            <button type="submit" class="btn-primary" style="margin-top:1rem;">Save Changes</button>
            <button type="button" class="btn-secondary" onclick="toggleForm('edit-form')">Cancel</button>
          </form>
        </div>
      <% } %>
    </section>

    <section id="roster" class="card admin-card admin-anchor-section" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Roster</h2>
          <p class="admin-card-copy">Everyone currently signed up to receive RSVP invitations.</p>
        </div>
        <div class="admin-cta-stack">
          <a href="/admin/participants" class="btn-secondary">Manage Roster</a>
          <a href="/admin/participants#add-member" class="btn-secondary">Add Member To Roster</a>
        </div>
      </div>

      <% if (inviteParticipants.length > 0) { %>
        <p class="admin-card-note" style="margin-bottom:1rem;">
          <strong><%= inviteParticipants.length %></strong> active participant<%= inviteParticipants.length === 1 ? '' : 's' %> will receive event invites.
        </p>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% inviteParticipants.forEach(function(participant) { %>
                <tr>
                  <td><%= participant.name %></td>
                  <td>
                    <a href="mailto:<%= participant.email %>" class="admin-email-link"><%= participant.email %></a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="admin-card-note">No one is on the roster yet. Add participants to start sending invitations.</p>
      <% } %>
    </section>

    <% if (event && roster.length > 0) { %>
      <section class="card admin-card">
        <h2 class="card-title" style="margin-bottom:1rem;">Responses</h2>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Response</th>
                <th>Comment</th>
                <th>Last updated</th>
              </tr>
            </thead>
            <tbody>
              <% roster.forEach(function(p) { %>
                <tr class="<%= p.status ? 'row-' + p.status : 'row-none' %>">
                  <td><%= p.name %></td>
                  <td>
                    <% if (p.status === 'yes') { %>
                      <span class="status-pill pill-yes">✓ Yes</span>
                    <% } else if (p.status === 'no') { %>
                      <span class="status-pill pill-no">✕ No</span>
                    <% } else if (p.status === 'maybe') { %>
                      <span class="status-pill pill-maybe">? Maybe</span>
                    <% } else { %>
                      <span class="status-pill pill-none">No response</span>
                    <% } %>
                  </td>
                  <td class="comment-cell"><%= p.comment || '' %></td>
                  <td class="date-cell">
                    <% if (p.updated_at) { %>
                      <%= new Date(p.updated_at + 'Z').toLocaleDateString('en-US', {month:'short',day:'numeric'}) %>
                    <% } else { %>—<% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

  </div>
</main>

<script>
function toggleForm(id) {
  const el = document.getElementById(id);
  if (el.style.display === 'none') {
    el.style.display = 'block';
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } else {
    el.style.display = 'none';
  }
}
</script>
<script src="/js/admin.js"></script>
</body>
</html>
