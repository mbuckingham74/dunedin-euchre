<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Dashboard</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="admin-page <%= showEditEventModal ? 'modal-open' : '' %>">

<%- include('../partials/admin-nav', { active: 'dashboard' }) %>

<main class="admin-main">
  <div class="admin-content">

    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">
    <div class="dashboard-grid">
      <section class="card admin-card dashboard-card dashboard-card-main">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">Current Event</h2>
            <p class="admin-card-copy">The selected game stays front and center, with quick follow-up actions close by.</p>
          </div>
        </div>

        <% if (allEvents.length > 0) { %>
          <form method="GET" action="/admin/dashboard" class="inline-form event-selector-form">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">View event</label>
                <select name="eventId" class="form-input">
                  <% allEvents.forEach(function(item) { %>
                    <option value="<%= item.id %>" <%= selectedEventId === item.id ? 'selected' : '' %>>
                      <%= item.event_date %> · <%= getEventTitle(item) %>
                    </option>
                  <% }); %>
                </select>
              </div>
              <button type="submit" class="btn-secondary" style="align-self:flex-end;">Load</button>
            </div>
          </form>
        <% } %>

        <% if (event) { %>
          <% const publicPath = buildPublicEventPath(event); %>
          <% const arrivalNotes = getArrivalNotes(event); %>
          <% const respondedCount = counts.yes + counts.maybe + counts.no; %>

          <div class="dashboard-current-shell">
            <div class="dashboard-current-summary">
              <p class="dashboard-kicker">Selected event</p>
              <h3 class="dashboard-current-title"><%= getEventTitle(event) %></h3>
              <div class="dashboard-status-row">
                <span class="status-pill <%= isEventPublished(event) ? 'pill-yes' : 'pill-none' %>">
                  <%= isEventPublished(event) ? 'Published' : 'Draft' %>
                </span>
                <span class="status-pill <%= isPublicRosterVisible(event) ? 'pill-yes' : 'pill-none' %>">
                  <%= isPublicRosterVisible(event) ? 'Names visible' : 'Names hidden' %>
                </span>
                <span class="status-pill pill-none"><%= respondedCount %> responded</span>
              </div>
            </div>

            <div class="dashboard-detail-grid">
              <article class="dashboard-detail-card">
                <p class="dashboard-detail-label">When</p>
                <p class="dashboard-detail-value"><%= formatEventDate(event.event_date) %></p>
                <p class="dashboard-detail-meta"><%= formatTime(event.start_time) %> – <%= formatTime(event.end_time) %></p>
              </article>

              <article class="dashboard-detail-card">
                <p class="dashboard-detail-label">Where</p>
                <p class="dashboard-detail-value"><%= event.location_name %></p>
                <% if (event.location_address) { %>
                  <p class="dashboard-detail-meta dashboard-detail-multiline"><%= event.location_address %></p>
                <% } %>
                <% if (event.map_link_url) { %>
                  <a href="<%= event.map_link_url %>" target="_blank" rel="noreferrer" class="event-map-link">Open map</a>
                <% } %>
              </article>

              <article class="dashboard-detail-card">
                <p class="dashboard-detail-label">Event page links</p>
                <% if (isEventPublished(event)) { %>
                  <a href="<%= publicPath %>" target="_blank" class="rsvp-link-preview"><%= baseUrl + publicPath %></a>
                <% } else { %>
                  <p class="dashboard-detail-meta">Draft only. Publish the event to make the event page available to invited guests.</p>
                <% } %>

                <% if (event.public_slug) { %>
                  <p class="dashboard-detail-meta">Active slug: <code><%= event.public_slug %></code></p>
                <% } else if (publicSlugHistory.length > 0) { %>
                  <p class="dashboard-detail-meta">None active. Using the event ID fallback URL.</p>
                <% } %>

                <% if (previousPublicSlugs.length > 0) { %>
                  <div class="dashboard-link-list">
                    <p class="dashboard-detail-label" style="margin-top:0.2rem;">Older event page URLs</p>
                    <% previousPublicSlugs.forEach(function(entry) { %>
                      <div>
                        <a href="/e/<%= entry.slug %>" target="_blank" class="rsvp-link-preview"><%= baseUrl %>/e/<%= entry.slug %></a>
                        <p class="dashboard-detail-meta">
                          <%= isEventPublished(event)
                            ? 'redirects to the current event page.'
                            : 'stays reserved for this event while the page is draft.' %>
                        </p>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </article>
            </div>

            <% if (arrivalNotes) { %>
              <div class="dashboard-note">
                <span class="notes-label">Event notes</span>
                <p class="notes-text"><%= arrivalNotes %></p>
              </div>
            <% } %>

            <div class="admin-actions">
              <button type="button" class="btn-secondary" onclick="openEditEventModal()">Edit event</button>
              <% if (inviteParticipants.length > 0) { %>
                <a href="/admin/event/<%= event.id %>/invite-preview" class="btn-secondary">Invite Preview</a>
                <a href="/admin/event/<%= event.id %>/invite-status" class="btn-secondary">Invite Delivery</a>
              <% } %>
              <form
                method="POST"
                action="/admin/event/<%= event.id %>/delete"
                onsubmit="return confirm('Delete this event and all of its RSVP responses? This cannot be undone.')"
              >
                <input type="hidden" name="_csrf" value="<%= _csrf %>">
                <button type="submit" class="btn-secondary btn-danger">Delete event</button>
              </form>
            </div>

          </div>
        <% } else { %>
          <div class="dashboard-empty-state">
            <p class="dashboard-empty-title">No events scheduled yet.</p>
            <p class="admin-card-copy">Create the first event here, or use the schedule page to work from the recurring fourth-Saturday dates.</p>
          </div>
        <% } %>
      </section>

      <section class="card admin-card dashboard-card dashboard-card-side">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">Quick Actions</h2>
            <p class="admin-card-copy">The most common admin tasks should stay one click away.</p>
          </div>
        </div>

        <div class="dashboard-action-stack">
          <button type="button" class="btn-primary dashboard-action-button" onclick="toggleForm('create-form')">+ New Event</button>
          <a href="/admin/events" class="btn-secondary dashboard-action-button">Open Schedule</a>
          <a href="/admin/testing" class="btn-secondary dashboard-action-button">Open Testing</a>
          <a href="/admin/participants" class="btn-secondary dashboard-action-button">Manage Roster</a>
          <a href="/admin/locations" class="btn-secondary dashboard-action-button">Manage Locations</a>
          <% if (event && isEventPublished(event)) { %>
            <a href="<%= buildPublicEventPath(event) %>" target="_blank" class="btn-secondary dashboard-action-button">Open Current Event Page</a>
          <% } %>
        </div>
      </section>

      <section class="card admin-card dashboard-card dashboard-card-third">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">RSVP Snapshot</h2>
            <p class="admin-card-copy">A quick read on the current event response mix.</p>
          </div>
        </div>

        <% if (event) { %>
          <div class="admin-counts dashboard-counts">
            <div class="admin-count-box count-yes"><span class="count-num"><%= counts.yes %></span><span class="count-lbl">Yes</span></div>
            <div class="admin-count-box count-maybe"><span class="count-num"><%= counts.maybe %></span><span class="count-lbl">Maybe</span></div>
            <div class="admin-count-box count-no"><span class="count-num"><%= counts.no %></span><span class="count-lbl">No</span></div>
            <div class="admin-count-box count-none"><span class="count-num"><%= counts.none %></span><span class="count-lbl">No response</span></div>
          </div>
          <p class="admin-card-note dashboard-summary-note">
            <strong><%= counts.yes + counts.maybe + counts.no %></strong> of
            <strong><%= counts.yes + counts.maybe + counts.no + counts.none %></strong>
            invited player<%= (counts.yes + counts.maybe + counts.no + counts.none) === 1 ? '' : 's' %> have responded.
          </p>
        <% } else { %>
          <p class="admin-card-note">Once an event is created, response totals will show here.</p>
        <% } %>
      </section>

      <section id="roster" class="card admin-card admin-anchor-section dashboard-card dashboard-card-third">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">Roster</h2>
            <p class="admin-card-copy">Everyone currently signed up to receive RSVP invitations.</p>
          </div>
        </div>

        <% if (inviteParticipants.length > 0) { %>
          <p class="admin-card-note dashboard-summary-note">
            <strong><%= inviteParticipants.length %></strong> active participant<%= inviteParticipants.length === 1 ? '' : 's' %> will receive event invites.
          </p>
          <div class="dashboard-mini-list">
            <% rosterPreview.forEach(function(participant) { %>
              <div class="dashboard-mini-item">
                <span class="dashboard-mini-title"><%= participant.name %></span>
                <span class="dashboard-mini-meta"><%= participant.email %></span>
              </div>
            <% }); %>
          </div>
          <% if (inviteParticipants.length > rosterPreview.length) { %>
            <p class="admin-card-note" style="margin-top:0.85rem;">+ <%= inviteParticipants.length - rosterPreview.length %> more on the roster.</p>
          <% } %>
        <% } else { %>
          <p class="admin-card-note">No one is on the roster yet. Add participants to start sending invitations.</p>
        <% } %>

        <div class="admin-actions" style="margin-top:1rem;">
          <a href="/admin/roster" class="btn-secondary">Open Full Roster</a>
          <a href="/admin/participants" class="btn-secondary">Manage Roster</a>
          <a href="/admin/participants#add-member" class="btn-secondary">Add Member To Roster</a>
        </div>
      </section>

      <section class="card admin-card dashboard-card dashboard-card-third">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">Locations</h2>
            <p class="admin-card-copy">Reusable venue details for event creation.</p>
          </div>
        </div>

        <% if (locations.length > 0) { %>
          <p class="admin-card-note dashboard-summary-note">
            <strong><%= locations.length %></strong> saved location<%= locations.length === 1 ? '' : 's' %> ready to use.
          </p>
          <div class="dashboard-mini-list">
            <% locationHighlights.forEach(function(location) { %>
              <div class="dashboard-mini-item">
                <span class="dashboard-mini-title"><%= location.name %></span>
                <span class="dashboard-mini-meta"><%= location.event_count %> event<%= location.event_count === 1 ? '' : 's' %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="admin-card-note">No saved locations yet. Add the first venue to make event creation easier.</p>
        <% } %>

        <div class="admin-actions" style="margin-top:1rem;">
          <a href="/admin/locations" class="btn-secondary">Manage Locations</a>
          <a href="/admin/locations" class="btn-secondary">Add Location</a>
        </div>
      </section>

      <section class="card admin-card dashboard-card dashboard-card-half">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">Upcoming Schedule</h2>
            <p class="admin-card-copy">The next few fourth-Saturday slots stay visible without opening the full schedule.</p>
          </div>
          <a href="/admin/events" class="btn-secondary btn-sm">View All</a>
        </div>

        <div class="dashboard-schedule-list">
          <% upcomingDashboardEntries.forEach(function(entry) { %>
            <article class="dashboard-schedule-item">
              <div>
                <p class="dashboard-mini-title"><%= entry.formattedDate %></p>
                <% if (entry.hasEvent) { %>
                  <p class="dashboard-mini-meta"><%= getEventTitle(entry.primaryEvent) %></p>
                <% } else { %>
                  <p class="dashboard-mini-meta">No event created yet.</p>
                <% } %>
              </div>

              <div class="dashboard-schedule-actions">
                <% if (entry.hasEvent) { %>
                  <span class="status-pill <%= isEventPublished(entry.primaryEvent) ? 'pill-yes' : 'pill-none' %>">
                    <%= isEventPublished(entry.primaryEvent) ? 'Published' : 'Draft' %>
                  </span>
                  <a href="/admin/dashboard?eventId=<%= entry.primaryEvent.id %>" class="btn-sm btn-secondary">Open</a>
                <% } else { %>
                  <span class="status-pill pill-none">Not created</span>
                  <a href="/admin/events#scheduled-<%= entry.dateKey %>" class="btn-sm btn-secondary">Schedule</a>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      </section>

      <section class="card admin-card dashboard-card dashboard-card-half">
        <div class="card-header">
          <div class="admin-card-header-text">
            <h2 class="card-title">Recent Responses</h2>
            <p class="admin-card-copy">The latest RSVP changes for the selected event.</p>
          </div>
        </div>

        <% if (event && recentResponses.length > 0) { %>
          <div class="dashboard-response-list">
            <% recentResponses.forEach(function(response) { %>
              <article class="dashboard-response-item">
                <div>
                  <p class="dashboard-mini-title"><%= response.name %></p>
                  <% if (response.comment) { %>
                    <p class="dashboard-mini-meta"><%= response.comment %></p>
                  <% } else { %>
                    <p class="dashboard-mini-meta">Updated <%= new Date(response.updated_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></p>
                  <% } %>
                </div>

                <div class="dashboard-response-side">
                  <% if (response.status === 'yes') { %>
                    <span class="status-pill pill-yes">Yes</span>
                  <% } else if (response.status === 'no') { %>
                    <span class="status-pill pill-no">No</span>
                  <% } else { %>
                    <span class="status-pill pill-maybe">Maybe</span>
                  <% } %>
                  <span class="date-cell"><%= new Date(response.updated_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else if (event) { %>
          <p class="admin-card-note">No RSVP replies yet for <strong><%= getEventTitle(event) %></strong>.</p>
        <% } else { %>
          <p class="admin-card-note">Responses will appear here after people start replying to an event invite.</p>
        <% } %>
      </section>
    </div>

    <section id="create-form" class="card admin-card dashboard-form-card" style="display:none;margin-top:1.5rem;">
      <div class="card-header">
        <div class="admin-card-header-text">
          <h2 class="card-title">Create New Event</h2>
          <p class="admin-card-copy">Use the saved locations list to set up the next game.</p>
        </div>
      </div>

      <form method="POST" action="/admin/event">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">
        <%- include('../partials/event-form', { event: null, locations: locations }) %>
        <div class="admin-actions" style="margin-top:1rem;">
          <button type="submit" class="btn-primary">Create Event</button>
          <button type="button" class="btn-secondary" onclick="toggleForm('create-form')">Cancel</button>
        </div>
      </form>
    </section>

    <% if (event) { %>
      <div
        id="edit-event-modal"
        class="modal-overlay"
        style="<%= showEditEventModal ? 'display:flex;' : 'display:none;' %>"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-event-modal-title"
        onclick="closeEditEventModal(event)"
      >
        <div class="modal-box event-edit-modal-box" onclick="event.stopPropagation()">
          <div class="scheduled-create-modal-header">
            <div class="admin-card-header-text">
              <h2 id="edit-event-modal-title" class="card-title">Edit Event</h2>
              <p class="admin-card-copy">Update the event details, then preview before sending the RSVP invite.</p>
            </div>
          </div>

          <form method="POST" action="/admin/event/<%= event.id %>/update">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <%- include('../partials/event-form', { event: event, locations: locations }) %>
            <div class="admin-actions" style="margin-top:1rem;">
              <button type="submit" class="btn-primary">Save Changes</button>
              <% if (inviteParticipants.length > 0) { %>
                <button type="submit" name="next_action" value="preview" class="btn-secondary">Invite Preview</button>
              <% } %>
              <button type="button" class="btn-secondary" onclick="closeEditEventModal()">Cancel</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>

  </div>
</main>

<script>
function toggleForm(id) {
  const el = document.getElementById(id);
  if (el.style.display === 'none') {
    el.style.display = 'block';
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } else {
    el.style.display = 'none';
  }
}

function openEditEventModal() {
  const modal = document.getElementById('edit-event-modal');
  if (!modal) return;
  modal.style.display = 'flex';
  document.body.classList.add('modal-open');

  const focusTarget = modal.querySelector('input[name="title"]');
  if (focusTarget) {
    window.requestAnimationFrame(() => focusTarget.focus());
  }
}

function closeEditEventModal(event) {
  const modal = document.getElementById('edit-event-modal');
  if (!modal) return;
  if (!event || event.target === modal) {
    modal.style.display = 'none';
    document.body.classList.remove('modal-open');
  }
}

document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    closeEditEventModal();
  }
});
</script>
<script src="/js/admin.js"></script>
</body>
</html>
