<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre – Participants</title>
  <link rel="stylesheet" href="<%= assetPath('/css/styles.css') %>">
</head>
<body class="admin-page">

<%- include('../partials/admin-nav', { active: 'participants' }) %>

<main class="admin-main">
  <div class="admin-content">

    <% if (flash) { %>
      <% const flashMessage = typeof flash === 'string' ? flash : flash.message; %>
      <% const flashTone = flash && flash.type === 'error' ? ' flash-msg-error' : ''; %>
      <div class="flash-msg<%= flashTone %>"><%= flashMessage %></div>
    <% } %>

    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="dashboard-logo">

    <div class="card admin-card" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <h2 class="card-title">RSVP Link Event</h2>
      </div>

      <% if (allEvents.length > 0) { %>
        <form method="GET" action="/admin/participants" class="inline-form">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Generate links for</label>
              <select name="eventId" class="form-input">
                <% allEvents.forEach(function(item) { %>
                  <option value="<%= item.id %>" <%= selectedEvent && selectedEvent.id === item.id ? 'selected' : '' %>>
                    <%= item.event_date %> · <%= getEventTitle(item) %>
                  </option>
                <% }); %>
              </select>
            </div>
            <button type="submit" class="btn-secondary" style="align-self:flex-end;">Load</button>
          </div>
        </form>

        <% if (selectedEvent) { %>
          <p style="margin-top:0.85rem;color:var(--gray-700);">
            Links below point to <strong><%= getEventTitle(selectedEvent) %></strong>.
            <% if (isEventPublished(selectedEvent)) { %>
              Event page:
              <a href="<%= buildPublicEventPath(selectedEvent) %>" target="_blank" rel="noopener noreferrer"><%= baseUrl + buildPublicEventPath(selectedEvent) %></a>
            <% } %>
          </p>
          <div class="admin-actions" style="margin-top:0.85rem;">
            <a href="<%= buildEventEditPath(selectedEvent.id) %>" class="btn-secondary">Back to Edit Event</a>
          </div>
          <p class="admin-card-note" style="margin-top:0.75rem;">
            Manual RSVP editing is enabled for this event, so you can update responses for anyone who calls or needs help.
          </p>
        <% } %>
      <% } else { %>
        <p style="color:var(--gray-500);">Create an event before generating RSVP links.</p>
      <% } %>
    </div>

    <div id="add-member" class="card admin-card admin-anchor-section" style="margin-bottom:1.5rem;">
      <div class="card-header">
        <h2 class="card-title">Add Participant</h2>
      </div>
      <form method="POST" action="/admin/participants" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= _csrf %>">
        <input type="hidden" name="selected_event_id" value="<%= selectedEvent ? selectedEvent.id : '' %>">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-input" required placeholder="email@example.com">
          </div>
          <div class="form-group party-member-group">
            <label class="form-label">Who is on this invite?</label>
            <div id="add-party-member-list" class="party-member-list" data-party-member-list></div>
            <div class="party-member-actions">
              <button type="button" class="btn-secondary btn-sm" data-party-open="add">Add person</button>
            </div>
            <div id="add-party-member-composer" class="party-member-composer party-member-composer-hidden">
              <label for="add-party-member-draft" class="form-label">Add person</label>
              <div class="party-member-composer-row">
                <input
                  type="text"
                  id="add-party-member-draft"
                  class="form-input"
                  data-party-draft="add"
                  placeholder="Person name"
                >
                <button type="button" class="btn-primary btn-sm" data-party-save="add">Add</button>
                <button type="button" class="btn-secondary btn-sm" data-party-cancel="add">Cancel</button>
              </div>
            </div>
            <p class="form-help">Use one box per person sharing this email address.</p>
          </div>
          <button type="submit" class="btn-primary" style="align-self:flex-end;">Add</button>
        </div>
      </form>
    </div>

    <section class="card admin-card">
      <h2 class="card-title" style="margin-bottom:1rem;">
        All Participants
        <span style="font-size:0.95rem;font-weight:400;color:var(--gray-500);">
          (<%= participants.filter(p => p.active).length %> active)
        </span>
      </h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Invitees</th>
              <th>RSVP Link</th>
              <th>Current RSVP</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% participants.forEach(function(p) { %>
              <% const rowClasses = []; %>
              <% if (!p.active) rowClasses.push('row-inactive'); %>
              <% if (p.active && p.currentResponse && p.currentResponse.status) rowClasses.push('row-' + p.currentResponse.status); %>
              <tr id="participant-<%= p.id %>" class="<%= rowClasses.join(' ') %>">
                <td id="name-cell-<%= p.id %>"><%= p.name %></td>
                <td id="email-cell-<%= p.id %>"><%= p.email %></td>
                <td>
                  <div><%= p.partyMembers.join(', ') %></div>
                  <div style="font-size:0.8rem;color:var(--gray-500);margin-top:0.2rem;">
                    <%= p.partyMembers.length %> invitee<%= p.partyMembers.length === 1 ? '' : 's' %>
                  </div>
                </td>
                <td>
                  <% const link = selectedEvent ? baseUrl + buildRsvpPath(p, selectedEvent) : null; %>
                  <% if (p.active && link) { %>
                    <a href="<%= link %>" target="_blank" rel="noopener noreferrer" class="rsvp-link-preview"><%= link %></a>
                    <button class="btn-copy btn-sm" data-copy="<%= link %>" title="Copy link">Copy</button>
                    <a
                      href="/admin/event/<%= selectedEvent.id %>/preview?participantId=<%= p.id %>"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-sm btn-secondary"
                      style="margin-left:0.4rem;"
                    >Preview RSVP</a>
                  <% } else if (p.active) { %>
                    <span style="color:var(--gray-400);">Create an event to generate a link.</span>
                  <% } else { %>
                    <span style="color:var(--gray-400);">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (p.active && selectedEvent) { %>
                    <div class="participant-response-summary">
                      <span class="status-pill <%= getParticipantResponseTone(p.currentResponse) %>"><%= getParticipantResponseLabel(p.currentResponse) %></span>
                      <div class="participant-response-copy">
                        <div class="participant-response-detail"><%= getParticipantResponseDetail(p.currentResponse) %></div>
                        <% if (p.currentResponse && p.currentResponse.comment) { %>
                          <div class="participant-response-comment"><%= p.currentResponse.comment %></div>
                        <% } %>
                        <% if (p.currentResponse && p.currentResponse.status && p.currentResponse.updated_at) { %>
                          <div class="participant-response-meta">Updated <%= formatResponseUpdatedAt(p.currentResponse.updated_at) %></div>
                        <% } %>
                      </div>
                    </div>
                  <% } else if (p.active) { %>
                    <span style="color:var(--gray-400);">Load an event to edit responses.</span>
                  <% } else { %>
                    <span style="color:var(--gray-400);">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (p.active) { %>
                    <span class="status-pill pill-yes">Active</span>
                  <% } else { %>
                    <span class="status-pill pill-no">Removed</span>
                  <% } %>
                </td>
                <td class="actions-cell">
                  <% if (p.active) { %>
                    <% if (selectedEvent) { %>
                      <button
                        type="button"
                        class="btn-sm btn-secondary edit-response-btn"
                        data-id="<%= p.id %>"
                        data-name="<%= p.name %>"
                        data-event-title="<%= getEventTitle(selectedEvent) %>"
                        data-response-status="<%= p.currentResponse && p.currentResponse.status ? p.currentResponse.status : '' %>"
                        data-response-comment="<%= p.currentResponse && p.currentResponse.comment ? p.currentResponse.comment : '' %>"
                        data-party-members="<%= encodeURIComponent(JSON.stringify(p.partyMembers)) %>"
                        data-attendee-names="<%= encodeURIComponent(JSON.stringify(p.currentResponse ? p.currentResponse.attendeeNames : [])) %>"
                      >Edit RSVP</button>
                    <% } %>
                    <button
                      type="button"
                      class="btn-sm btn-secondary edit-participant-btn"
                      data-id="<%= p.id %>"
                      data-email="<%= p.email %>"
                      data-party-members="<%= encodeURIComponent(JSON.stringify(p.partyMembers)) %>"
                      data-selected-event-id="<%= selectedEvent ? selectedEvent.id : '' %>"
                    >Edit</button>
                    <form method="POST" action="/admin/participants/<%= p.id %>/delete" style="display:inline;"
                          onsubmit="return confirm('Remove <%= p.name %>?')">
                      <input type="hidden" name="_csrf" value="<%= _csrf %>">
                      <input type="hidden" name="selected_event_id" value="<%= selectedEvent ? selectedEvent.id : '' %>">
                      <button type="submit" class="btn-sm btn-danger">Remove</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</main>

<div id="edit-modal" class="modal-overlay" style="display:none;" onclick="closeEditModal(event)">
  <div class="modal-box" onclick="event.stopPropagation()">
    <h3 style="margin-bottom:1rem;">Edit Participant</h3>
    <form id="edit-form" method="POST" action="">
      <input type="hidden" name="_csrf" value="<%= _csrf %>">
      <input type="hidden" id="edit-selected-event-id" name="selected_event_id" value="">
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" id="edit-email" name="email" class="form-input" required>
      </div>
      <div class="form-group party-member-group" style="margin-top:0.75rem;">
        <label class="form-label">Who is on this invite?</label>
        <div id="edit-party-member-list" class="party-member-list" data-party-member-list></div>
        <div class="party-member-actions">
          <button type="button" class="btn-secondary btn-sm" data-party-open="edit">Add person</button>
        </div>
        <div id="edit-party-member-composer" class="party-member-composer party-member-composer-hidden">
          <label for="edit-party-member-draft" class="form-label">Add person</label>
          <div class="party-member-composer-row">
            <input
              type="text"
              id="edit-party-member-draft"
              class="form-input"
              data-party-draft="edit"
              placeholder="Person name"
            >
            <button type="button" class="btn-primary btn-sm" data-party-save="edit">Add</button>
            <button type="button" class="btn-secondary btn-sm" data-party-cancel="edit">Cancel</button>
          </div>
        </div>
        <p class="form-help">Use one box per person sharing this email address.</p>
      </div>
      <div style="margin-top:1.25rem;display:flex;gap:0.75rem;">
        <button type="submit" class="btn-primary">Save</button>
        <button type="button" class="btn-secondary" onclick="closeEditModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<div id="response-modal" class="modal-overlay" style="display:none;" onclick="closeResponseModal(event)">
  <div class="modal-box response-modal-box" onclick="event.stopPropagation()">
    <h3 id="response-modal-title" style="margin-bottom:0.35rem;">Edit RSVP</h3>
    <p id="response-modal-event" class="response-editor-note"></p>
    <form id="response-form" method="POST" action="">
      <input type="hidden" name="_csrf" value="<%= _csrf %>">
      <input type="hidden" name="selected_event_id" value="<%= selectedEvent ? selectedEvent.id : '' %>">
      <div class="form-group">
        <label class="form-label">Response</label>
        <select id="response-status" name="status" class="form-input">
          <option value="">No response</option>
          <option value="yes">Yes</option>
          <option value="maybe">Maybe</option>
          <option value="no">No</option>
        </select>
      </div>
      <div id="response-attendee-wrap" class="response-attendee-wrap" hidden>
        <label class="form-label">Who is attending?</label>
        <div id="response-attendee-list" class="response-attendee-list"></div>
        <p class="form-help">Select each invitee who should count as attending.</p>
      </div>
      <div class="form-group" style="margin-top:0.85rem;">
        <label class="form-label">Comment</label>
        <textarea
          id="response-comment"
          name="comment"
          class="form-input"
          rows="4"
          maxlength="400"
          placeholder="Optional note for mom’s records"
        ></textarea>
      </div>
      <p class="response-editor-note" style="margin-top:0.85rem;">
        Invitee self-service can close after the event starts, but this manual override remains available for exceptions.
      </p>
      <div style="margin-top:1.25rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
        <button type="submit" class="btn-primary">Save RSVP</button>
        <button type="button" class="btn-secondary" onclick="closeResponseModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
function closeEditModal(e) {
  if (!e || e.target === document.getElementById('edit-modal')) {
    closePartyMemberComposer('edit');
    document.getElementById('edit-modal').style.display = 'none';
  }
}

function closeResponseModal(e) {
  if (!e || e.target === document.getElementById('response-modal')) {
    document.getElementById('response-modal').style.display = 'none';
  }
}

function decodeNameList(value) {
  if (!value) return [];

  try {
    const parsed = JSON.parse(decodeURIComponent(value));
    return Array.isArray(parsed) ? parsed : [];
  } catch (error) {
    return [];
  }
}

function getPartyMemberValues(container) {
  return Array.from(container.querySelectorAll('input[name="party_member_names"]')).map(function(input) {
    return input.value;
  });
}

function getPartyMemberElements(prefix) {
  return {
    list: document.getElementById(prefix + '-party-member-list'),
    composer: document.getElementById(prefix + '-party-member-composer'),
    draft: document.getElementById(prefix + '-party-member-draft')
  };
}

function renderPartyMemberList(container, names) {
  const values = (Array.isArray(names) ? names : []).filter(function(name) {
    return String(name || '').trim();
  });
  const displayValues = values.length > 0 ? values : [''];

  container.innerHTML = '';

  displayValues.forEach(function(value, index) {
    const row = document.createElement('div');
    row.className = 'party-member-row';

    const input = document.createElement('input');
    input.type = 'text';
    input.name = 'party_member_names';
    input.className = 'form-input';
    input.placeholder = 'Person ' + (index + 1) + ' name';
    input.value = value || '';
    input.required = index === 0;
    row.appendChild(input);

    if (displayValues.length > 1) {
      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'btn-secondary btn-sm';
      removeButton.textContent = 'Remove';
      removeButton.addEventListener('click', function() {
        const nextValues = getPartyMemberValues(container);
        nextValues.splice(index, 1);
        renderPartyMemberList(container, nextValues);
      });
      row.appendChild(removeButton);
    }

    container.appendChild(row);
  });
}

function openPartyMemberComposer(prefix) {
  const elements = getPartyMemberElements(prefix);
  if (!elements.composer || !elements.draft) return;

  elements.composer.classList.remove('party-member-composer-hidden');
  elements.draft.value = '';
  elements.draft.focus();
}

function closePartyMemberComposer(prefix) {
  const elements = getPartyMemberElements(prefix);
  if (!elements.composer || !elements.draft) return;

  elements.composer.classList.add('party-member-composer-hidden');
  elements.draft.value = '';
}

function addPartyMemberFromComposer(prefix) {
  const elements = getPartyMemberElements(prefix);
  if (!elements.list || !elements.draft) return;

  const value = String(elements.draft.value || '').trim();
  if (!value) {
    elements.draft.focus();
    return;
  }

  const nextValues = getPartyMemberValues(elements.list);
  nextValues.push(value);
  renderPartyMemberList(elements.list, nextValues);
  closePartyMemberComposer(prefix);
}

document.querySelectorAll('[data-party-open]').forEach(function(button) {
  button.addEventListener('click', function() {
    openPartyMemberComposer(button.dataset.partyOpen);
  });
});

document.querySelectorAll('[data-party-save]').forEach(function(button) {
  button.addEventListener('click', function() {
    addPartyMemberFromComposer(button.dataset.partySave);
  });
});

document.querySelectorAll('[data-party-cancel]').forEach(function(button) {
  button.addEventListener('click', function() {
    closePartyMemberComposer(button.dataset.partyCancel);
  });
});

document.querySelectorAll('[data-party-draft]').forEach(function(input) {
  input.addEventListener('keydown', function(event) {
    if (event.key === 'Enter') {
      event.preventDefault();
      addPartyMemberFromComposer(input.dataset.partyDraft);
    } else if (event.key === 'Escape') {
      event.preventDefault();
      closePartyMemberComposer(input.dataset.partyDraft);
    }
  });
});

renderPartyMemberList(document.getElementById('add-party-member-list'), ['']);
renderPartyMemberList(document.getElementById('edit-party-member-list'), ['']);

document.querySelectorAll('.edit-participant-btn').forEach(function(button) {
  button.addEventListener('click', function() {
    document.getElementById('edit-form').action = '/admin/participants/' + button.dataset.id + '/update';
    document.getElementById('edit-email').value = button.dataset.email || '';
    renderPartyMemberList(
      document.getElementById('edit-party-member-list'),
      decodeNameList(button.dataset.partyMembers)
    );
    closePartyMemberComposer('edit');
    document.getElementById('edit-selected-event-id').value = button.dataset.selectedEventId || '';
    document.getElementById('edit-modal').style.display = 'flex';
  });
});

function syncResponseAttendeeVisibility() {
  const statusInput = document.getElementById('response-status');
  const attendeeWrap = document.getElementById('response-attendee-wrap');
  if (!statusInput || !attendeeWrap) return;

  attendeeWrap.hidden = statusInput.value !== 'yes';
}

function renderResponseAttendeeList(names, selectedNames) {
  const attendeeList = document.getElementById('response-attendee-list');
  if (!attendeeList) return;

  attendeeList.innerHTML = '';
  const normalizedSelected = new Set((Array.isArray(selectedNames) ? selectedNames : []).map(function(name) {
    return String(name || '').trim().toLowerCase();
  }));
  const values = Array.isArray(names) ? names : [];

  values.forEach(function(name, index) {
    const label = document.createElement('label');
    label.className = 'form-checkbox response-attendee-option';

    const input = document.createElement('input');
    input.type = 'checkbox';
    input.name = 'attendee_names';
    input.value = name;
    input.checked = normalizedSelected.has(String(name || '').trim().toLowerCase());

    if (values.length === 1 && normalizedSelected.size === 0) {
      input.checked = true;
    }

    label.appendChild(input);
    label.appendChild(document.createTextNode(name || ('Invitee ' + (index + 1))));
    attendeeList.appendChild(label);
  });
}

document.getElementById('response-status').addEventListener('change', function() {
  syncResponseAttendeeVisibility();
});

document.querySelectorAll('.edit-response-btn').forEach(function(button) {
  button.addEventListener('click', function() {
    document.getElementById('response-form').action = '/admin/participants/' + button.dataset.id + '/response';
    document.getElementById('response-modal-title').textContent = 'Edit RSVP for ' + (button.dataset.name || 'participant');
    document.getElementById('response-modal-event').textContent = 'Updating ' + (button.dataset.eventTitle || 'this event') + '.';
    document.getElementById('response-status').value = button.dataset.responseStatus || '';
    document.getElementById('response-comment').value = button.dataset.responseComment || '';
    renderResponseAttendeeList(
      decodeNameList(button.dataset.partyMembers),
      decodeNameList(button.dataset.attendeeNames)
    );
    syncResponseAttendeeVisibility();
    document.getElementById('response-modal').style.display = 'flex';
  });
});

document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    closeResponseModal();
  }
});
</script>
<script src="<%= assetPath('/js/admin.js') %>"></script>
</body>
</html>
