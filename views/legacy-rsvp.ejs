<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="site-logo">
    <span class="site-title">Dunedin Euchre</span>
  </div>
</header>
<main style="max-width:600px;margin:3rem auto;padding:0 1.5rem;">
  <div class="card">
    <h2>This RSVP link is out of date</h2>
    <p style="margin-top:1rem;font-size:1.1rem;color:var(--gray-700);">
      <% if (participant) { %>
      Hi <strong><%= participant.name %></strong> — this older link no longer identifies which event you were invited to.
      <% } else { %>
      This older link no longer identifies which event you were invited to.
      <% } %>
      Please use the latest RSVP email from the organizer.
    </p>
  </div>
</main>
</body>
</html>
