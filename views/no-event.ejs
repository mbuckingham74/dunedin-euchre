<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dunedin Euchre</title>
  <link rel="stylesheet" href="<%= assetPath('/css/styles.css') %>">
  <link rel="manifest" href="<%= assetPath('/manifest.json') %>">
  <meta name="theme-color" content="#0077b6">
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <img src="/images/dunedin-logo-transparent.png" alt="Dunedin Euchre" class="site-logo">
    <span class="site-title">Dunedin Euchre</span>
  </div>
</header>
<main style="max-width:600px;margin:3rem auto;padding:0 1.5rem;">
  <div class="card">
    <h2>No upcoming event</h2>
    <p style="margin-top:1rem;font-size:1.1rem;color:var(--gray-700);">
      Hi <strong><%= participant.name %></strong> — there's no event scheduled yet.
      Check back soon!
    </p>
  </div>
</main>
</body>
</html>
